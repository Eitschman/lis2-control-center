<Window x:Class="LIS2.ProtocolTester.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIS2 Protocol Tester"
        Width="920" Height="720"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="0,0,0,10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4"><Grid RowDefinitions="Auto,*"><TextBlock Text="Connection" Margin="10,6,10,0" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Margin="10" Orientation="Horizontal">
                <CheckBox x:Name="VirtualModeCheckBox" Content="Virtual LIS2" IsChecked="True"
                          VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock Text="Serial port:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PortComboBox" Width="140" Margin="0,0,8,0" IsEnabled="False"/>
                <Button Content="Refresh" Click="RefreshPorts_Click" Padding="14,5" Margin="0,0,8,0"/>
                <Button x:Name="ConnectButton" Content="Connect" Click="Connect_Click" Padding="14,5" Margin="0,0,8,0"/>
                <TextBlock x:Name="ConnectionStatus" Text="Disconnected" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid></Border>

        <Border Grid.Row="1" Margin="0,0,0,10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4"><Grid RowDefinitions="Auto,*"><TextBlock Text="Display" Margin="10,6,10,0" FontWeight="SemiBold"/>
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="Line1TextBox" Grid.Row="0" Grid.Column="1" MaxLength="40" Margin="0,0,8,8"/>
                <Button Grid.Row="0" Grid.Column="2" x:Name="SendLine1Button" Content="Send" Click="SendLine1_Click" Padding="14,5" Margin="0,0,8,8"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2:" VerticalAlignment="Center" Margin="0,0,8,8"/>
                <TextBox x:Name="Line2TextBox" Grid.Row="1" Grid.Column="1" MaxLength="40" Margin="0,0,8,8"/>
                <Button Grid.Row="1" Grid.Column="2" x:Name="SendLine2Button" Content="Send" Click="SendLine2_Click" Padding="14,5" Margin="0,0,8,8"/>

                <Button Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" x:Name="ClearDisplayButton" Content="Clear (A0)" Click="Clear_Click" Padding="14,5" Margin="0,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Brightness:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal">
                    <Button Content="100%" Tag="100" Click="Brightness_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="75%" Tag="75" Click="Brightness_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="50%" Tag="50" Click="Brightness_Click" Padding="12,4" Margin="0,0,6,0"/>
                    <Button Content="25%" Tag="25" Click="Brightness_Click" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Grid></Border>

        <Border Grid.Row="2" Margin="0,0,0,10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4"><Grid RowDefinitions="Auto,*"><TextBlock Text="Fan control" Margin="10,6,10,0" FontWeight="SemiBold"/>
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="F1 %" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="Fan1TextBox" Grid.Column="1" Text="100" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="2" Text="F2 %" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="Fan2TextBox" Grid.Column="3" Text="100" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="4" Text="F3 %" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="Fan3TextBox" Grid.Column="5" Text="100" Margin="0,0,12,0"/>
                <TextBlock Grid.Column="6" Text="F4 %" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="Fan4TextBox" Grid.Column="7" Text="100" Margin="0,0,12,0"/>
                <Button Grid.Column="8" x:Name="SendFansButton" Content="Send fan values" ToolTip.Tip="Start at 100% for hardware validation" Click="SendFans_Click" Padding="14,5" HorizontalAlignment="Left"/>
            </Grid>
        </Grid></Border>

        <Border Grid.Row="3" Margin="0,0,0,10" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4"><Grid RowDefinitions="Auto,*"><TextBlock Text="Custom character" Margin="10,6,10,0" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Margin="10" Orientation="Horizontal">
                <TextBlock Text="Slot:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="CharacterSlotTextBox" Width="40" Text="1" Margin="0,0,10,0"/>
                <TextBlock Text="Rows (hex, 00..1F):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBox x:Name="CharacterRowsTextBox" Width="250" Text="00 04 0E 1F 0E 04 00 00" Margin="0,0,10,0"/>
                <Button x:Name="ProgramCharacterButton" Content="Program 8 rows" Click="ProgramCharacter_Click" Padding="14,5"/>
            </StackPanel>
        </Grid></Border>

        <Border Grid.Row="4" Margin="" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1" CornerRadius="4"><Grid RowDefinitions="Auto,*"><TextBlock Text="TX log" Margin="10,6,10,0" FontWeight="SemiBold"/>
            <Grid Grid.Row="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="LogTextBox" Grid.Row="0" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"/>
                <Button Grid.Row="1" x:Name="ClearLogButton" Content="Clear log" Click="ClearLog_Click"
                        HorizontalAlignment="Right" Padding="14,5" Margin="0,8,0,0"/>
            </Grid>
        </Grid></Border>
        <TextBlock x:Name="ErrorText" Grid.Row="5" Foreground="Red" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </Grid>
</Window>
