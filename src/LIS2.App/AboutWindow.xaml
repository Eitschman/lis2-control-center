<Window x:Class="LIS2.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About LIS2 Control Center"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="24" Background="{DynamicResource AppBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="AppIconImage" Width="48" Height="48" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="LIS2 Control Center"
                                   FontSize="22"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="VersionText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="145"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Build" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BuildText" Margin="0,3"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="RuntimeText" Margin="0,3"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Architecture" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ArchitectureText" Margin="0,3"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Operating system" FontWeight="SemiBold" Margin="0,3"/>
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="OperatingSystemText" Margin="0,3" TextWrapping="Wrap"/>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Application data" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DataDirectoryText"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="3">
                <Button Content="GitHub"
                        Click="GitHub_Click"
                        HorizontalAlignment="Left"
                        MinWidth="100"/>
                <Button Content="Close"
                        Click="Close_Click"
                        HorizontalAlignment="Right"
                        MinWidth="100"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
