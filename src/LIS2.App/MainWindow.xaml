<Window x:Class="LIS2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIS2 Control Center"
        Width="1320" Height="900"
        MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="LIS2 CONTROL CENTER"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="4,18,0,24"/>

                <StackPanel x:Name="NavigationPanel" Grid.Row="1">
                    <Button Tag="0" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌂" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="1" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▣" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Display" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="2" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▤" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Pages" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="3" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="♫" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Winamp" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="4" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚠" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Events" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="5" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▦" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Hardware" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="6" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✽" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Fan Control" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="7" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚙" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="8" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="∿" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Diagnostics" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Tag="9" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⌂" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Home Assistant" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>

                    <Separator Margin="4,18,4,16"/>

                    <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock x:Name="TransportSummaryText"
                                   Text="Virtual LIS2"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,8">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="Connected" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <Button Content="Change..."
                                Tag="7"
                                Click="Navigation_Click"
                                HorizontalAlignment="Left"
                                MinWidth="110"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="4,12,0,10">
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="ⓘ  LIS2 Control Center" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="FooterVersionText"
                               FontSize="11"
                               Foreground="{DynamicResource DisabledTextBrush}"
                               Margin="25,3,0,8"/>
                    <TextBlock Text="◉  GitHub"
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,0,0,5"
                               Cursor="Hand"
                               MouseLeftButtonUp="GitHub_MouseLeftButtonUp"/>
                    <TextBlock Text="ⓘ  About"
                               Foreground="{DynamicResource MutedBrush}"
                               Cursor="Hand"
                               MouseLeftButtonUp="About_MouseLeftButtonUp"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SectionHeaderGrid" Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SectionTitleText"
                                   Text="Dashboard"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="SectionHelpButton"
                                Content="?"
                                Width="32"
                                Height="32"
                                Margin="12,1,0,0"
                                Padding="0"
                                FontSize="16"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"
                                ToolTip="Help for this page"
                                Click="Help_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="SectionSubtitleText"
                               Text="Overview and quick access to the most important functions."
                               Foreground="{DynamicResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border x:Name="ConnectionBadge"
                        Grid.Column="1"
                        Background="{DynamicResource StatusBadgeBrush}"
                        CornerRadius="14"
                        Padding="14,9"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="ConnectionText"
                               Text="Disconnected"
                               Foreground="{DynamicResource StatusBadgeTextBrush}"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>

            <TabControl x:Name="MainTabs"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- Dashboard -->
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                        <Border Background="{DynamicResource VfdBackgroundBrush}" BorderBrush="{DynamicResource VfdBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="24,20">
                                            <StackPanel>
                                                <TextBlock x:Name="PreviewLine1"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="31"
                                                           Foreground="{DynamicResource VfdTextBrush}"/>
                                                <TextBlock x:Name="PreviewLine2"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="31"
                                                           Foreground="{DynamicResource VfdTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="System Status" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="VirtualStateText"
                                                       Text="State available when Virtual transport is active."
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Quick Links" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                            <Button Content="Open Display Controls" Tag="1" Click="Navigation_Click" Margin="0,0,0,6"/>
                                            <Button Content="Open Fan Control" Tag="6" Click="Navigation_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="18"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fan 1" VerticalAlignment="Center"/>
                                            <Slider x:Name="DashboardFan1Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="10"
                                                    Margin="6,0,10,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=DashboardFan1Slider, Path=Value, StringFormat={}{0:0} %}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"/>
                                        </Grid>

                                        <Grid Grid.Row="0" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fan 2" VerticalAlignment="Center"/>
                                            <Slider x:Name="DashboardFan2Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="10"
                                                    Margin="6,0,10,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=DashboardFan2Slider, Path=Value, StringFormat={}{0:0} %}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"/>
                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fan 3" VerticalAlignment="Center"/>
                                            <Slider x:Name="DashboardFan3Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="10"
                                                    Margin="6,0,10,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=DashboardFan3Slider, Path=Value, StringFormat={}{0:0} %}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"/>
                                        </Grid>

                                        <Grid Grid.Row="2" Grid.Column="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Fan 4" VerticalAlignment="Center"/>
                                            <Slider x:Name="DashboardFan4Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                    Grid.Column="1"
                                                    Minimum="0" Maximum="100" Value="100"
                                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                                    SmallChange="1" LargeChange="10"
                                                    Margin="6,0,10,0"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding ElementName=DashboardFan4Slider, Path=Value, StringFormat={}{0:0} %}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Consolas"/>
                                        </Grid>

                                        <Button Grid.Row="4"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Content="Apply"
                                                Click="DashboardFans_Click"
                                                HorizontalAlignment="Right"
                                                MinWidth="110"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource TipBackgroundBrush}"
                                    BorderBrush="{DynamicResource TipBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9">
                                <TextBlock Foreground="{DynamicResource MutedBrush}"
                                           Text="💡  Tip: Use the navigation on the left to access display settings, page editor, Winamp integration, hardware and fan control."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Display -->
                <TabItem Header="Display">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Quick Display Test" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1" Margin="0,0,10,9" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,9"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Send" Click="SendLine1_Click" Margin="0,0,0,9"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2" Margin="0,0,10,9" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,9"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Send" Click="SendLine2_Click" Margin="0,0,0,9"/>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Button Content="Render both lines" Click="RenderBoth_Click" Margin="0,0,7,0"/>
                                            <Button Content="Clear" Click="Clear_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Character ROM / Special Characters"
                                               FontWeight="SemiBold"
                                               FontSize="16"
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Native LIS2 characters use the uPD16314 ROM. Test the mapped Unicode set or inspect raw ROM bytes on the real display."
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,12"/>

                                    <WrapPanel Margin="0,0,0,12">
                                        <Button Content="Send special-character test"
                                                Click="SendSpecialCharacterTest_Click"
                                                Margin="0,0,8,0"/>
                                        <TextBlock Text="Ä Ö Ü  ä ö ü  ß  °  µ  ±  £  ×  ÷  ← →  Ω π Σ √ ∞"
                                                   FontFamily="Consolas"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"/>
                                    </WrapPanel>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="ROM start byte"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <TextBox x:Name="CharacterRomStartTextBox"
                                                 Grid.Column="1"
                                                 Text="80"
                                                 FontFamily="Consolas"
                                                 MaxLength="2"
                                                 Margin="0,0,8,0"/>
                                        <Button Grid.Column="2"
                                                Content="Previous"
                                                Click="CharacterRomPrevious_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Grid.Column="3"
                                                Content="Send 40 bytes"
                                                Click="SendCharacterRomRange_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Grid.Column="4"
                                                Content="Next"
                                                Click="CharacterRomNext_Click"/>
                                        <TextBlock x:Name="CharacterRomRangeText"
                                                   Grid.Column="5"
                                                   Text="80-A7"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="Custom Characters / CG Builder"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   DockPanel.Dock="Left"/>
                                        <CheckBox x:Name="ProgramCustomGlyphsOnConnectCheckBox"
                                                  Content="Program saved glyphs on connect"
                                                  Checked="ProgramCustomGlyphsOnConnectChanged"
                                                  Unchecked="ProgramCustomGlyphsOnConnectChanged"
                                                  DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Slot" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="CustomGlyphSlotComboBox" SelectionChanged="CustomGlyphSlotChanged" Margin="0,0,0,10"/>
                                            <TextBlock Text="Name" Margin="0,0,0,5"/>
                                            <TextBox x:Name="CustomGlyphNameTextBox" TextChanged="CustomGlyphNameChanged"/>
                                            <TextBlock Text="Template key" Margin="0,10,0,4" Foreground="{DynamicResource MutedBrush}"/>
                                            <TextBlock x:Name="CustomGlyphTemplateKeyText"
                                                       Text="{}{Glyph.1}"
                                                       FontFamily="Consolas"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="5x8 bitmap (8 rows)" Margin="0,0,0,5"/>
                                            <TextBox x:Name="CustomGlyphRowsTextBox"
                                                     FontFamily="Consolas"
                                                     AcceptsReturn="True"
                                                     Height="150"
                                                     TextChanged="CustomGlyphRowsChanged"
                                                     Text="00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000"/>
                                        </StackPanel>
                                        <Border Grid.Column="3"
                                                Background="{DynamicResource VfdBackgroundBrush}"
                                                BorderBrush="{DynamicResource VfdBorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="16">
                                            <StackPanel>
                                                <TextBlock x:Name="CustomGlyphPreview"
                                                           FontFamily="Consolas"
                                                           FontSize="22"
                                                           Foreground="{DynamicResource VfdTextBrush}"
                                                           Text="·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····"/>
                                                <TextBlock Text="20x2 template preview"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,12,0,4"/>
                                                <TextBlock x:Name="CustomGlyphLinePreview"
                                                           FontFamily="Consolas"
                                                           FontSize="18"
                                                           Foreground="{DynamicResource VfdTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Save glyph" Click="SaveCustomGlyph_Click" Margin="0,0,7,7"/>
                                        <Button Content="Send slot to LIS2" Click="SendCustomGlyph_Click" Margin="0,0,7,7"/>
                                        <Button Content="Send all 8 slots" Click="SendAllCustomGlyphs_Click" Margin="0,0,14,7"/>
                                        <Button Content="Load set..." Click="LoadCustomGlyphSet_Click" Margin="0,0,7,7"/>
                                        <Button Content="Save set..." Click="SaveCustomGlyphSet_Click" Margin="0,0,7,7"/>
                                        <Button Content="Load examples" Click="LoadExampleGlyphSet_Click" Margin="0,0,0,7"/>
                                    </WrapPanel>
                                    <TextBlock Text="Use {Glyph.Name} or {Glyph.1} through {Glyph.8} in page templates."
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="100%" Tag="100" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="75%" Tag="75" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="50%" Tag="50" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="25%" Tag="25" Click="Brightness_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pages -->
                <TabItem Header="Pages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>

                                    <TextBlock Text="Preset" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="PagePresetComboBox"
                                              DisplayMemberPath="Label"
                                              SelectedValuePath="Id"
                                              Margin="0,0,0,6"/>
                                    <Button Content="Create from preset"
                                            Click="CreatePagePreset_Click"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,12"/>

                                    <ListBox x:Name="PagesListBox"
                                             MinHeight="250"
                                             MaxHeight="420"
                                             SelectionChanged="PagesListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Click="PageEnabledChanged"
                                                              VerticalAlignment="Center"
                                                              Margin="2,0,8,0"/>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Add" Click="AddPage_Click" Margin="0,0,7,7"/>
                                        <Button Content="Duplicate" Click="DuplicatePage_Click" Margin="0,0,7,7"/>
                                        <Button Content="Delete" Click="DeletePage_Click" Margin="0,0,0,7"/>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                        <Button Content="↑  Move up"
                                                Click="MovePageUp_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Content="↓  Move down"
                                                Click="MovePageDown_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 1" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageLine1TextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" TextChanged="PageEditorChanged"
                                             ToolTip="Formatting: {Key|fallback:--|number:1|percent:0|bytes:1|prefix:...|suffix:...|upper|lower}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Line 2" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageLine2TextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" TextChanged="PageEditorChanged"
                                             ToolTip="Formatting: {Key|fallback:--|number:1|percent:0|bytes:1|prefix:...|suffix:...|upper|lower}"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration (s)" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageDurationTextBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Visible when" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="95"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="1.3*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PageVisibilityKeyComboBox"
                                                      Grid.Column="0"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="True"
                                                      DisplayMemberPath="Display"
                                                      SelectedValuePath="Key"
                                                      ToolTip="Choose a data value or type a template key."/>
                                            <ComboBox x:Name="PageVisibilityOperatorComboBox"
                                                      Grid.Column="2"
                                                      SelectedValuePath="Tag">
                                                <ComboBoxItem Content="=" Tag="=" IsSelected="True"/>
                                                <ComboBoxItem Content="!=" Tag="!="/>
                                                <ComboBoxItem Content="&gt;" Tag="&gt;"/>
                                                <ComboBoxItem Content="&gt;=" Tag="&gt;="/>
                                                <ComboBoxItem Content="&lt;" Tag="&lt;"/>
                                                <ComboBoxItem Content="&lt;=" Tag="&lt;="/>
                                            </ComboBox>
                                            <TextBox x:Name="PageVisibilityValueTextBox"
                                                     Grid.Column="4"
                                                     ToolTip="Comparison value"/>
                                            <Button Grid.Column="6"
                                                    Content="Apply condition"
                                                    Click="BuildVisibilityExpression_Click"/>
                                        </Grid>
                                        <TextBox x:Name="PageVisibilityTextBox"
                                                 Margin="0,6,0,0"
                                                 ToolTip="Raw expression, e.g. Winamp.State=Playing or HA.sensor.temperature&gt;25"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Overflow" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Line 1" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PageLine1OverflowComboBox">
                                                <ComboBoxItem Content="Ping-pong" Tag="PingPong" IsSelected="True"/>
                                                <ComboBoxItem Content="Truncate" Tag="Truncate"/>
                                                <ComboBoxItem Content="Marquee" Tag="Marquee"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Line 2" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                            <ComboBox x:Name="PageLine2OverflowComboBox">
                                                <ComboBoxItem Content="Ping-pong" Tag="PingPong" IsSelected="True"/>
                                                <ComboBoxItem Content="Truncate" Tag="Truncate"/>
                                                <ComboBoxItem Content="Marquee" Tag="Marquee"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Scroll timing" Margin="0,0,10,10" VerticalAlignment="Top"/>
                                    <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Step (ms)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PageScrollSpeedTextBox" Text="300"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Edge pause (ms)" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                                            <TextBox x:Name="PageEdgePauseTextBox" Text="900"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,12">
                                        <TextBlock Text="Live preview"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,6"/>
                                        <Border Background="{DynamicResource VfdBackgroundBrush}"
                                                BorderBrush="{DynamicResource VfdBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="18,12"
                                                Width="500"
                                                HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock x:Name="PageEditorPreviewLine1"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="26"
                                                           Foreground="{DynamicResource VfdTextBrush}"/>
                                                <TextBlock x:Name="PageEditorPreviewLine2"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="26"
                                                           Foreground="{DynamicResource VfdTextBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Save page" Click="SavePage_Click" Margin="0,0,7,0"/>
                                        <Button Content="Test event (5 s)" Click="TestEvent_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Winamp -->
                <TabItem Header="Winamp">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="WinampTitleText"
                                                   Text="Nothing playing"
                                                   FontSize="26"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WinampArtistText"
                                                   Text="Waiting for Winamp..."
                                                   FontSize="17"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="WinampAlbumText"
                                                   Text=""
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <Border Grid.Column="1"
                                            Background="{DynamicResource StatusBadgeBrush}"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            VerticalAlignment="Top"
                                            Margin="16,0,0,0">
                                        <TextBlock x:Name="WinampStatusText"
                                                   Text="Waiting for Winamp"
                                                   Foreground="{DynamicResource StatusBadgeTextBrush}"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Playback" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="WinampPlaybackText"
                                                   Text="Unknown"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock x:Name="WinampTimeText"
                                                   Text="--:-- / --:--"
                                                   FontFamily="Consolas"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Playlist" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="WinampPlaylistText"
                                                   Text="- / -"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Current position / total tracks"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Audio" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="WinampAudioText"
                                                   Text="-"
                                                   FontSize="20"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Bitrate / sample rate"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="VU / Spectrum"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,20,0"/>
                                        <TextBlock x:Name="WinampTelemetryStatusText"
                                                   Grid.Column="1"
                                                   Text="No visualization data"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="WinampVuLeftBar"
                                                     Grid.Row="0" Grid.Column="1"
                                                     Minimum="0" Maximum="255"
                                                     Height="18"/>
                                        <TextBlock x:Name="WinampVuLeftText"
                                                   Grid.Row="0" Grid.Column="2"
                                                   Text="0"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="WinampVuRightBar"
                                                     Grid.Row="2" Grid.Column="1"
                                                     Minimum="0" Maximum="255"
                                                     Height="18"/>
                                        <TextBlock x:Name="WinampVuRightText"
                                                   Grid.Row="2" Grid.Column="2"
                                                   Text="0"
                                                   FontFamily="Consolas"
                                                   HorizontalAlignment="Right"/>

                                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="{DynamicResource VfdBackgroundBrush}"
                                                BorderBrush="{DynamicResource VfdBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="12,8">
                                            <TextBlock x:Name="WinampSpectrumText"
                                                       Text="                    "
                                                       FontFamily="Consolas"
                                                       FontSize="22"
                                                       Foreground="{DynamicResource VfdTextBrush}"/>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Create Now Playing page"
                                                Tag="NowPlaying"
                                                Click="CreateWinampPreset_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Content="Create VU page"
                                                Tag="VU"
                                                Click="CreateWinampPreset_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Content="Create Spectrum page"
                                                Tag="Spectrum"
                                                Click="CreateWinampPreset_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Integration Status" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock x:Name="WinampConnectionDetailText"
                                               Text="Listening on \\.\pipe\LIS2ControlCenter.Winamp"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}"/>
                                    <TextBlock Text="Install gen_lis2.dll in Winamp's Plugins folder, or run LIS2.WinampSimulator while testing without Winamp."
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Visibility="Collapsed">
                                <!-- WMP integration intentionally disabled for now; implementation retained for later reactivation. -->
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Windows Media Player Legacy"
                                                   FontWeight="SemiBold"
                                                   FontSize="18"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,20,0"/>
                                        <Border Grid.Column="1"
                                                Background="{DynamicResource StatusBadgeBrush}"
                                                CornerRadius="12"
                                                Padding="12,8">
                                            <TextBlock x:Name="WmpLegacyStatusText"
                                                       Text="Waiting for WMP Legacy"
                                                       Foreground="{DynamicResource StatusBadgeTextBrush}"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock x:Name="WmpLegacyTitleText"
                                               Text="Nothing playing"
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="WmpLegacyArtistText"
                                               Text="Waiting for Windows Media Player Legacy..."
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="WmpLegacyAlbumText"
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,3,0,10"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Playback" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WmpLegacyPlaybackText" Text="Unknown" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WmpLegacyTimeText" Text="--:-- / --:--"
                                                       FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Playlist" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WmpLegacyPlaylistText" Text="- / -" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="Track number / total tracks" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Visualization" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="WmpLegacyVisualizationStatusText"
                                                       Text="No visualization data"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Select the LIS2 visualization in WMP Legacy for VU/spectrum."
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="55"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="7"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Left" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="WmpLegacyVuLeftBar" Grid.Row="0" Grid.Column="1"
                                                     Minimum="0" Maximum="255" Height="18"/>
                                        <TextBlock x:Name="WmpLegacyVuLeftText" Grid.Row="0" Grid.Column="2"
                                                   Text="0" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Right" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="WmpLegacyVuRightBar" Grid.Row="2" Grid.Column="1"
                                                     Minimum="0" Maximum="255" Height="18"/>
                                        <TextBlock x:Name="WmpLegacyVuRightText" Grid.Row="2" Grid.Column="2"
                                                   Text="0" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="{DynamicResource VfdBackgroundBrush}"
                                                BorderBrush="{DynamicResource VfdBorderBrush}"
                                                BorderThickness="1" CornerRadius="5" Padding="12,8">
                                            <TextBlock x:Name="WmpLegacySpectrumText"
                                                       Text="                    "
                                                       FontFamily="Consolas" FontSize="22"
                                                       Foreground="{DynamicResource VfdTextBrush}"/>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Margin="0,2,0,10">
                                        <Button Content="Create Now Playing page" Tag="NowPlaying"
                                                Click="CreateWmpLegacyPreset_Click" Margin="0,0,7,6"/>
                                        <Button Content="Create VU page" Tag="VU"
                                                Click="CreateWmpLegacyPreset_Click" Margin="0,0,7,6"/>
                                        <Button Content="Create Spectrum page" Tag="Spectrum"
                                                Click="CreateWmpLegacyPreset_Click" Margin="0,0,0,6"/>
                                    </WrapPanel>

                                    <TextBlock x:Name="WmpLegacyConnectionDetailText"
                                               Text="Listening on \\.\pipe\LIS2ControlCenter.WmpLegacy"
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="Register the matching x86/x64 WMP Legacy background and visualization DLLs with regsvr32."
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,8"/>
                                    <TextBlock FontFamily="Consolas"
                                               Text="{}{WmpLegacy.State}   {WmpLegacy.Artist}   {WmpLegacy.Title}   {WmpLegacy.Album}&#x0a;{WmpLegacy.Elapsed}   {WmpLegacy.Duration}   {WmpLegacy.TrackNumber}   {WmpLegacy.PlaylistCount}&#x0a;{WmpLegacy.Connected}   {WmpLegacy.VisualizationConnected}   {WmpLegacy.Vu}&#x0a;{WmpLegacy.Spectrum}   {WmpLegacy.SpectrumGlyphs}"
                                               Foreground="{DynamicResource LogTextBrush}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Available page variables" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock FontFamily="Consolas"
                                               Text="{}{Winamp.State}   {Winamp.Artist}   {Winamp.Title}   {Winamp.Album}&#x0a;{Winamp.Elapsed}   {Winamp.Duration}   {Winamp.PlaylistPosition}   {Winamp.PlaylistCount}&#x0a;{Winamp.BitrateKbps}   {Winamp.SampleRateHz}&#x0a;{Winamp.Connected}   {Winamp.VuLeft}   {Winamp.VuRight}   {Winamp.Vu}&#x0a;{Winamp.Spectrum}   {Winamp.SpectrumGlyphs}"
                                               Foreground="{DynamicResource LogTextBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Events -->
                <TabItem Header="Events">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Line 1"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,9"/>
                                <TextBox x:Name="EventLine1TextBox"
                                         Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4"
                                         MaxLength="20"
                                         Text="BUILD FINISHED"
                                         Margin="0,0,0,9"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Line 2"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,9"/>
                                <TextBox x:Name="EventLine2TextBox"
                                         Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                         MaxLength="20"
                                         Text="0 errors"
                                         Margin="0,0,0,9"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Priority"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,9"/>
                                <ComboBox x:Name="EventPriorityComboBox"
                                          Grid.Row="2" Grid.Column="1"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Margin="0,0,0,9">
                                    <ComboBoxItem Content="Info (10)" Tag="10"/>
                                    <ComboBoxItem Content="Notice (50)" Tag="50" IsSelected="True"/>
                                    <ComboBoxItem Content="Warning (100)" Tag="100"/>
                                    <ComboBoxItem Content="Critical (200)" Tag="200"/>
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="3"
                                           Text="Duration (s)"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,9"/>
                                <TextBox x:Name="EventDurationTextBox"
                                         Grid.Row="2" Grid.Column="4"
                                         Text="5"
                                         Margin="0,0,0,9"/>

                                <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
                                            Orientation="Horizontal">
                                    <Button Content="Show event"
                                            Click="AddEvent_Click"
                                            Margin="0,0,7,0"/>
                                    <Button Content="Test warning"
                                            Click="TestWarningEvent_Click"
                                            Margin="0,0,7,0"/>
                                    <Button Content="Clear all"
                                            Click="ClearEvents_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="Active / queued events"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="EventQueueSummaryText"
                                               Text="0 events"
                                               Foreground="{DynamicResource MutedBrush}"
                                               DockPanel.Dock="Right"/>
                                </DockPanel>

                                <ListBox x:Name="EventQueueListBox"
                                         Grid.Row="1"
                                         MinHeight="220"
                                         SelectionChanged="EventQueueListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding PriorityName}"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Remaining}"
                                                           FontFamily="Consolas"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource MutedBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Grid Grid.Row="2" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SelectedEventText"
                                               Grid.Column="0"
                                               Text="Select an event to inspect it."
                                               Foreground="{DynamicResource MutedBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Margin="0,0,14,0"/>
                                    <Button Grid.Column="1"
                                            Content="Cancel selected"
                                            Click="CancelSelectedEvent_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Hardware -->
                <TabItem Header="Hardware">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="240"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Hardware Monitoring" FontWeight="SemiBold" FontSize="18"/>
                                    <TextBlock x:Name="HardwareSummaryText"
                                               Text="Waiting for LibreHardwareMonitor values..."
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,6,0,0"/>
                                </StackPanel>

                                <TextBox x:Name="HardwareSearchTextBox"
                                         Grid.Column="1"
                                         VerticalAlignment="Center"
                                         ToolTip="Search by sensor name, alias or key"
                                         TextChanged="HardwareFilterChanged"/>

                                <ComboBox x:Name="HardwareTypeComboBox"
                                          Grid.Column="3"
                                          VerticalAlignment="Center"
                                          SelectionChanged="HardwareFilterChanged">
                                    <ComboBoxItem Content="All types" Tag="All" IsSelected="True"/>
                                    <ComboBoxItem Content="Favorites" Tag="Favorites"/>
                                    <ComboBoxItem Content="Unavailable" Tag="Unavailable"/>
                                    <ComboBoxItem Content="Temperature" Tag="Temperature"/>
                                    <ComboBoxItem Content="Load" Tag="Load"/>
                                    <ComboBoxItem Content="Fan" Tag="Fan"/>
                                    <ComboBoxItem Content="Clock" Tag="Clock"/>
                                    <ComboBoxItem Content="Voltage" Tag="Voltage"/>
                                    <ComboBoxItem Content="Power" Tag="Power"/>
                                    <ComboBoxItem Content="Data" Tag="Data"/>
                                    <ComboBoxItem Content="Throughput" Tag="Throughput"/>
                                    <ComboBoxItem Content="Other" Tag="Other"/>
                                </ComboBox>

                                <Button Grid.Column="5"
                                        Content="Refresh"
                                        Click="RefreshHardware_Click"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="HardwareSensorsListBox"
                                         Grid.Row="0"
                                         Grid.RowSpan="2"
                                         SelectionChanged="HardwareSensorsListBox_SelectionChanged"
                                         HorizontalContentAlignment="Stretch">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="{x:Type ListBox}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="8,0,8,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="2.1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1*"/>
                                                            <ColumnDefinition Width="2.8*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="★" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Sensor" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="3" Text="Value" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="4" Text="Template key" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <ScrollViewer Focusable="False"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource AppBackgroundBrush}"
                                                            Padding="8,6"
                                                            Margin="0,8,0,4">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ListBox.GroupStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="2.1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="2.8*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FavoriteMarker}"
                                                               Foreground="{DynamicResource AccentBrush}"/>
                                                    <TextBlock Text="{Binding AvailabilityMarker}"
                                                               Foreground="{DynamicResource DangerBrush}"
                                                               Margin="2,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                    <TextBlock Text="{Binding SensorName}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Type}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayValue}"
                                                           FontFamily="Consolas"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Key}"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Selected sensor" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock x:Name="SelectedHardwareSensorText"
                                               Text="Select a sensor above."
                                               Foreground="{DynamicResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,5,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Alias" VerticalAlignment="Center"/>
                                        <TextBox x:Name="HardwareAliasTextBox" Grid.Column="1"/>
                                        <CheckBox x:Name="HardwareFavoriteCheckBox"
                                                  Grid.Column="3"
                                                  Content="Favorite"
                                                  VerticalAlignment="Center"/>
                                        <Button Grid.Column="5"
                                                Content="Save sensor"
                                                Click="SaveHardwarePreference_Click"/>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Use for Fan 1" Tag="0" Click="AssignHardwareSensorToFan_Click" Margin="0,0,7,0"/>
                                    <Button Content="Fan 2" Tag="1" Click="AssignHardwareSensorToFan_Click" Margin="0,0,7,0"/>
                                    <Button Content="Fan 3" Tag="2" Click="AssignHardwareSensorToFan_Click" Margin="0,0,7,0"/>
                                    <Button Content="Fan 4" Tag="3" Click="AssignHardwareSensorToFan_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Display presets" FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Create display pages automatically from sensors available on this computer."
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,5,20,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="CPU" Tag="CPU" Click="CreateHardwarePreset_Click" Margin="0,0,7,0"/>
                                    <Button Content="GPU" Tag="GPU" Click="CreateHardwarePreset_Click" Margin="0,0,7,0"/>
                                    <Button Content="Memory" Tag="Memory" Click="CreateHardwarePreset_Click" Margin="0,0,7,0"/>
                                    <Button Content="Temperatures" Tag="Temperatures" Click="CreateHardwarePreset_Click" Margin="0,0,7,0"/>
                                    <Button Content="Fans" Tag="Fans" Click="CreateHardwarePreset_Click"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Fan Control -->
                <TabItem Header="Fan Control">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Fan Outputs" FontWeight="SemiBold" FontSize="18"
                                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                                        <CheckBox x:Name="AutomaticFanControlCheckBox" Grid.Column="1"
                                                  Content="Automatic control"
                                                  Checked="AutomaticFanControlChanged"
                                                  Unchecked="AutomaticFanControlChanged"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="65"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="14"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fan 1" VerticalAlignment="Center"/>
                                        <Slider x:Name="Fan1Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                Grid.Row="0" Grid.Column="1"
                                                Minimum="0" Maximum="100" Value="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="10"
                                                Margin="6,0,12,0"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding ElementName=Fan1Slider, Path=Value, StringFormat={}{0:0} %}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fan 2" VerticalAlignment="Center"/>
                                        <Slider x:Name="Fan2Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                Grid.Row="2" Grid.Column="1"
                                                Minimum="0" Maximum="100" Value="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="10"
                                                Margin="6,0,12,0"/>
                                        <TextBlock Grid.Row="2" Grid.Column="2"
                                                   Text="{Binding ElementName=Fan2Slider, Path=Value, StringFormat={}{0:0} %}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fan 3" VerticalAlignment="Center"/>
                                        <Slider x:Name="Fan3Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                Grid.Row="4" Grid.Column="1"
                                                Minimum="0" Maximum="100" Value="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="10"
                                                Margin="6,0,12,0"/>
                                        <TextBlock Grid.Row="4" Grid.Column="2"
                                                   Text="{Binding ElementName=Fan3Slider, Path=Value, StringFormat={}{0:0} %}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Fan 4" VerticalAlignment="Center"/>
                                        <Slider x:Name="Fan4Slider"
                                                AutoToolTipPlacement="TopLeft"
                                                AutoToolTipPrecision="0"
                                                Style="{StaticResource FanSliderStyle}"
                                                Grid.Row="6" Grid.Column="1"
                                                Minimum="0" Maximum="100" Value="100"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                SmallChange="1" LargeChange="10"
                                                Margin="6,0,12,0"/>
                                        <TextBlock Grid.Row="6" Grid.Column="2"
                                                   Text="{Binding ElementName=Fan4Slider, Path=Value, StringFormat={}{0:0} %}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Consolas"/>

                                        <Button Grid.Row="8"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Content="Apply"
                                                Click="Fans_Click"
                                                HorizontalAlignment="Right"
                                                MinWidth="110"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Channels" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                        <ListBox x:Name="FanChannelsListBox" MinHeight="240" MaxHeight="420" SelectionChanged="FanChannelsListBox_SelectionChanged"/>
                                        <Button Content="Refresh sensors"
                                                Click="RefreshFanSensors_Click"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Mode" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FanModeComboBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Fixed" Tag="Fixed"/>
                                            <ComboBoxItem Content="Curve" Tag="Curve"/>
                                            <ComboBoxItem Content="Follow" Tag="Follow"/>
                                            <ComboBoxItem Content="External" Tag="External"/>
                                            <ComboBoxItem Content="Off" Tag="Off"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sensor" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FanSensorComboBox"
                                                  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fixed %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanFixedTextBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Minimum %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanMinimumTextBox" Grid.Row="2" Grid.Column="4" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Maximum %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanMaximumTextBox" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Fail-safe %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanFailSafeTextBox" Grid.Row="3" Grid.Column="4" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Curve" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanCurveTextBox"
                                                 Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                                 Margin="0,0,0,10"
                                                 TextChanged="FanCurveTextChanged"
                                                 ToolTip="Format: 40:40;60:80;75:100"/>

                                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Hysteresis °C" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanHysteresisTextBox"
                                                 Grid.Row="5" Grid.Column="1"
                                                 Width="90" HorizontalAlignment="Left"
                                                 Text="1.0" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="FanAllowStopCheckBox"
                                                  Grid.Row="5" Grid.Column="3" Grid.ColumnSpan="2"
                                                  Content="Allow 0% / stop"
                                                  Margin="0,0,0,10"/>

                                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,0,0,10">
                                            <TextBlock x:Name="FanLiveStatusText"
                                                       Text="Sensor: -  |  Output: -"
                                                       FontFamily="Consolas"
                                                       Margin="0,0,0,6"/>
                                            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                                                <Canvas x:Name="FanCurvePreviewCanvas" MinWidth="280" Height="120" HorizontalAlignment="Stretch"/>
                                            </Border>
                                        </StackPanel>

                                        <Button Grid.Row="7" Grid.Column="1"
                                                Content="Save fan channel"
                                                Click="SaveFanChannel_Click"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Settings -->
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Device / Transport" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Transport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="TransportModeComboBox" Grid.Column="1" SelectionChanged="TransportModeChanged" Margin="0,0,16,0">
                                            <ComboBoxItem Content="Virtual" IsSelected="True"/>
                                            <ComboBoxItem Content="Serial"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="COM port" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="PortComboBox" Grid.Column="3" IsEnabled="False" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Refresh" Click="RefreshPorts_Click" Margin="0,0,7,0"/>
                                            <Button Content="Apply / reconnect" Click="ApplyDeviceSettings_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="Theme"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,10"/>
                                        <ComboBox x:Name="ThemeModeComboBox"
                                                  Grid.Row="0" Grid.Column="1"
                                                  Margin="0,0,0,10"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectionChanged="ThemeModeChanged"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2"
                                                   Margin="14,0,0,10"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="System default follows the Windows app theme automatically."
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0"
                                                   Text="Language"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <ComboBox x:Name="LanguageModeComboBox"
                                                  Grid.Row="1" Grid.Column="1"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectionChanged="LanguageModeChanged"/>
                                        <TextBlock Grid.Row="1" Grid.Column="2"
                                                   Margin="14,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   Text="System default uses the Windows display language."
                                                   TextWrapping="Wrap"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Windows" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              Content="Start LIS2 Control Center with Windows (minimized to tray)"
                                              Checked="StartWithWindowsChanged"
                                              Unchecked="StartWithWindowsChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Diagnostics -->
                <TabItem Header="Diagnostics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="180"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="*" MinHeight="180"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" MinWidth="300"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="0.85*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <GridSplitter Grid.Row="1"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeNS"/>

                        <GridSplitter Grid.Row="0"
                                      Grid.RowSpan="3"
                                      Grid.Column="1"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Stretch"
                                      ResizeDirection="Columns"
                                      ResizeBehavior="PreviousAndNext"
                                      Cursor="SizeWE"/>

                        <Border Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Diagnostics Snapshot"
                                               FontWeight="SemiBold"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button Content="Export report..."
                                                Click="ExportDiagnostics_Click"
                                                Margin="0,0,7,0"/>
                                        <Button Content="Refresh"
                                                Click="RefreshDiagnostics_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="DiagnosticsTextBox"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource LogBackgroundBrush}"
                                         Foreground="{DynamicResource LogTextBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Virtual LIS2 state"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="VirtualLis2StateTextBox"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource LogBackgroundBrush}"
                                         Foreground="{DynamicResource LogTextBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Decoded command history"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="CommandHistoryTextBox"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource LogBackgroundBrush}"
                                         Foreground="{DynamicResource LogTextBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                           Text="Protocol Log"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>
                                <TextBox x:Name="LogTextBox"
                                         Grid.Row="1"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         Background="{DynamicResource LogBackgroundBrush}"
                                         Foreground="{DynamicResource LogTextBrush}"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Home Assistant -->
                <TabItem Header="Home Assistant">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="60"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto" MinHeight="205"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Connection"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           Margin="0,0,0,10"/>

                                <CheckBox x:Name="HomeAssistantEnabledCheckBox"
                                          Content="Enable Home Assistant"
                                          Margin="0,0,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="URL"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,10"/>
                                    <TextBox x:Name="HomeAssistantUrlTextBox"
                                             Grid.Row="0" Grid.Column="1"
                                             Margin="0,0,0,10"
                                             ToolTip="Example: http://homeassistant.local:8123"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Token"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <PasswordBox x:Name="HomeAssistantTokenPasswordBox"
                                                 Grid.Row="1" Grid.Column="1"
                                                 ToolTip="Home Assistant long-lived access token"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Margin="0,12,0,0">
                                    <Button Content="Test connection"
                                            Click="TestHomeAssistant_Click"
                                            Margin="0,0,7,0"/>
                                    <Button Content="Save / reconnect"
                                            Click="SaveHomeAssistant_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Home Assistant entities"
                                           FontWeight="SemiBold"
                                           FontSize="18"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="HomeAssistantSearchTextBox"
                                         Grid.Row="0" Grid.Column="2"
                                         ToolTip="Search entity ID, friendly name or alias"
                                         TextChanged="HomeAssistantFilterChanged"
                                         VerticalAlignment="Center"/>

                                <ComboBox x:Name="HomeAssistantDomainComboBox"
                                          Grid.Row="0" Grid.Column="4"
                                          SelectionChanged="HomeAssistantFilterChanged"
                                          VerticalAlignment="Center"/>

                                <TextBlock x:Name="HomeAssistantStatusText"
                                           Grid.Row="1" Grid.Column="0"
                                           Grid.ColumnSpan="5"
                                           Text="Not configured"
                                           Foreground="{DynamicResource MutedBrush}"
                                           Margin="0,7,0,0"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <ListBox x:Name="HomeAssistantEntitiesListBox"
                                         Grid.Row="0"
                                         Grid.RowSpan="2"
                                         HorizontalContentAlignment="Stretch"
                                         SelectionChanged="HomeAssistantEntitiesListBox_SelectionChanged"
                                         MouseDoubleClick="HomeAssistantEntitiesListBox_MouseDoubleClick">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="{x:Type ListBox}">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Top" Margin="8,0,8,7">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="2.2*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="1.1*"/>
                                                            <ColumnDefinition Width="2.6*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="★" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="1" Text="Entity" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                                                        <TextBlock Grid.Column="2" Text="Domain" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                                                        <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                                                        <TextBlock Grid.Column="4" Text="Template key" FontWeight="SemiBold" HorizontalAlignment="Left" TextAlignment="Left"/>
                                                    </Grid>

                                                    <ScrollViewer Focusable="False"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  VerticalScrollBarVisibility="Auto">
                                                        <ItemsPresenter/>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </ListBox.Template>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="2.2*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="2.6*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding FavoriteMarker}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                    <TextBlock Text="{Binding EntityId}"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Domain}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding DisplayState}"
                                                           FontFamily="Consolas"
                                                           Margin="0,0,10,0"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding TemplateKey}"
                                                           FontFamily="Consolas"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Top"
                                                           HorizontalAlignment="Left"
                                                           TextAlignment="Left"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Row="3"
                                      Height="6"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      Background="{DynamicResource PanelBorderBrush}"
                                      Cursor="SizeNS"
                                      Margin="8,0"/>

                        <Border x:Name="HomeAssistantDetailBorder"
                                Grid.Row="4"
                                Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.05*"/>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="1.45*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Selected entity"
                                               FontWeight="SemiBold"
                                               FontSize="16"/>

                                    <TextBlock x:Name="SelectedHomeAssistantEntityText"
                                               Grid.Row="1"
                                               Text="Select an entity above."
                                               Foreground="{DynamicResource MutedBrush}"
                                               Margin="0,5,0,10"
                                               TextWrapping="Wrap"
                                               MaxHeight="58"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Alias"
                                                   VerticalAlignment="Center"/>
                                        <TextBox x:Name="HomeAssistantAliasTextBox"
                                                 Grid.Column="1"/>
                                        <CheckBox x:Name="HomeAssistantFavoriteCheckBox"
                                                  Grid.Column="3"
                                                  Content="Favorite"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <WrapPanel x:Name="HomeAssistantEntityActionsPanel"
                                               Grid.Row="3"
                                               HorizontalAlignment="Right"
                                               Margin="0,10,0,0">
                                        <Button Content="Copy key"
                                                Click="CopyHomeAssistantEntityKey_Click"
                                                Margin="0,0,7,6"/>
                                        <Button Content="Save entity"
                                                Click="SaveHomeAssistantEntity_Click"
                                                Margin="0,0,7,6"/>
                                        <Button Content="Create display page"
                                                Click="CreateHomeAssistantPage_Click"
                                                Margin="0,0,0,6"/>
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Attributes"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"/>
                                        <StackPanel x:Name="HomeAssistantAttributeActionsPanel"
                                                    Grid.Column="1"
                                                    Orientation="Horizontal">
                                            <Button Content="Copy key"
                                                    Click="CopyHomeAssistantAttributeKey_Click"
                                                    Margin="0,0,7,0"/>
                                            <Button Content="Create attribute page"
                                                    Click="CreateHomeAssistantAttributePage_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <ListBox x:Name="HomeAssistantAttributesListBox"
                                             Grid.Row="1"
                                             MinHeight="120"
                                             HorizontalContentAlignment="Stretch"
                                             MouseDoubleClick="HomeAssistantAttributesListBox_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.15*"/>
                                                        <ColumnDefinition Width="0.9*"/>
                                                        <ColumnDefinition Width="2.15*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Name}"
                                                               Margin="0,0,10,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding DisplayValue}"
                                                               ToolTip="{Binding Value}"
                                                               FontFamily="Consolas"
                                                               Margin="0,0,10,0"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding TemplateKey}"
                                                               FontFamily="Consolas"
                                                               Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               HorizontalAlignment="Left"
                                                               TextAlignment="Left"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
