<Window x:Class="LIS2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIS2 Control Center"
        Width="1040" Height="760"
        MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#101214"
        Foreground="#F0F0F0">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#181B1F" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="LIS2 CONTROL CENTER" FontWeight="Bold" FontSize="16" Margin="0,0,0,18"/>
                <Button Content="Dashboard" Padding="10" Margin="0,0,0,6"/>
                <Button Content="Display" Padding="10" Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Pages" Padding="10" Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Winamp" Padding="10" Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Hardware" Padding="10" Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Fan Control" Padding="10" Margin="0,0,0,6" IsEnabled="False"/>
                <Button Content="Settings" Padding="10" Margin="0,0,0,6" Click="Settings_Click"/>
                <Button Content="Diagnostics" Padding="10" IsEnabled="False"/>
                <Separator Margin="0,18,0,12"/>
                <TextBlock Text="Transport" FontWeight="Bold"/>
                <TextBlock x:Name="TransportSummaryText" Text="Virtual LIS2" Foreground="#A9B1B8" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,18">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="First application shell — currently using the Virtual LIS2"
                                   Foreground="#A9B1B8" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border x:Name="ConnectionBadge" DockPanel.Dock="Right" Background="#26312A"
                            CornerRadius="12" Padding="12,6" HorizontalAlignment="Right">
                        <TextBlock x:Name="ConnectionText" Text="Disconnected"/>
                    </Border>
                </DockPanel>

                <GroupBox Header="VFD preview" Foreground="#F0F0F0" Margin="0,0,0,14">
                    <Border Margin="10" Padding="20" Background="#050B08" CornerRadius="6">
                        <StackPanel>
                            <TextBlock x:Name="PreviewLine1" Text="                    "
                                       FontFamily="Consolas" FontSize="30"
                                       Foreground="#8FFFA0"/>
                            <TextBlock x:Name="PreviewLine2" Text="                    "
                                       FontFamily="Consolas" FontSize="30"
                                       Foreground="#8FFFA0"/>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox Header="Quick display test" Foreground="#F0F0F0" Margin="0,0,0,14">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1" Margin="0,0,10,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,8"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Send" Click="SendLine1_Click" Padding="14,5" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2" Margin="0,0,10,8" VerticalAlignment="Center"/>
                        <TextBox x:Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,8"/>
                        <Button Grid.Row="1" Grid.Column="2" Content="Send" Click="SendLine2_Click" Padding="14,5" Margin="0,0,0,8"/>

                        <Button Grid.Row="2" Grid.Column="1" Content="Render both lines" Click="RenderBoth_Click"
                                HorizontalAlignment="Left" Padding="14,5"/>
                        <Button Grid.Row="2" Grid.Column="2" Content="Clear" Click="Clear_Click" Padding="14,5"/>
                    </Grid>
                </GroupBox>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Column="0" Header="Brightness" Foreground="#F0F0F0">
                        <WrapPanel Margin="10">
                            <Button Content="100%" Tag="100" Click="Brightness_Click" Padding="12,5" Margin="0,0,6,6"/>
                            <Button Content="75%" Tag="75" Click="Brightness_Click" Padding="12,5" Margin="0,0,6,6"/>
                            <Button Content="50%" Tag="50" Click="Brightness_Click" Padding="12,5" Margin="0,0,6,6"/>
                            <Button Content="25%" Tag="25" Click="Brightness_Click" Padding="12,5" Margin="0,0,6,6"/>
                        </WrapPanel>
                    </GroupBox>

                    <GroupBox Grid.Column="2" Header="Fan outputs (virtual)" Foreground="#F0F0F0">
                        <Grid Margin="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="Fan1TextBox" Grid.Column="1" Text="100" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="2" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="Fan2TextBox" Grid.Column="3" Text="100" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="4" Text="3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="Fan3TextBox" Grid.Column="5" Text="100" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="6" Text="4" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="Fan4TextBox" Grid.Column="7" Text="100" Margin="0,0,8,0"/>
                            <StackPanel Grid.Column="8">
                                <Button Content="Apply" Click="Fans_Click" Padding="12,5" HorizontalAlignment="Left"/>
                                <CheckBox x:Name="AutomaticFanControlCheckBox"
                                          Content="Automatic"
                                          Margin="0,7,0,0"
                                          Checked="AutomaticFanControlChanged"
                                          Unchecked="AutomaticFanControlChanged"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>

                <GroupBox Header="Pages" Foreground="#F0F0F0" Margin="0,0,0,14">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ListBox x:Name="PagesListBox" Height="150" SelectionChanged="PagesListBox_SelectionChanged"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Add" Click="AddPage_Click" Padding="10,4" Margin="0,0,6,0"/>
                                <Button Content="Delete" Click="DeletePage_Click" Padding="10,4"/>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="PageNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 1" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="PageLine1TextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Line 2" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="PageLine2TextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration (s)" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="PageDurationTextBox" Grid.Row="3" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Visible when" Margin="0,0,8,8" VerticalAlignment="Center"/>
                            <TextBox x:Name="PageVisibilityTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"
                                     ToolTip="Example: Winamp.State=Playing"/>

                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Save page" Click="SavePage_Click" Padding="12,5" Margin="0,0,6,0"/>
                                <Button Content="Test event (5 s)" Click="TestEvent_Click" Padding="12,5"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Virtual LIS2 state" Foreground="#F0F0F0" Margin="0,0,0,14">
                    <TextBlock x:Name="VirtualStateText" Margin="10" FontFamily="Consolas"
                               Text="State available when Virtual transport is active."/>
                </GroupBox>

                <GroupBox Header="Device settings" Foreground="#F0F0F0" Margin="0,0,0,14">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Transport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="TransportModeComboBox" Grid.Column="1" SelectionChanged="TransportModeChanged" Margin="0,0,16,0">
                            <ComboBoxItem Content="Virtual" IsSelected="True"/>
                            <ComboBoxItem Content="Serial"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" Text="COM port" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="PortComboBox" Grid.Column="3" IsEnabled="False" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <Button Content="Refresh" Click="RefreshPorts_Click" Padding="12,5" Margin="0,0,6,0"/>
                            <Button Content="Apply / reconnect" Click="ApplyDeviceSettings_Click" Padding="12,5"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Protocol log" Foreground="#F0F0F0">
                    <TextBox x:Name="LogTextBox" Margin="10" Height="180" IsReadOnly="True"
                             FontFamily="Consolas" Background="#0C0E10" Foreground="#D8DEE4"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
