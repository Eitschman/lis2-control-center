<Window x:Class="LIS2.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIS2 Control Center"
        Width="1240" Height="820"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#171B20" BorderBrush="#252B32" BorderThickness="0,0,1,0">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="LIS2 CONTROL CENTER"
                           FontWeight="Bold"
                           FontSize="16"
                           Margin="4,18,0,24"/>

                <StackPanel x:Name="NavigationPanel" Grid.Row="1">
                    <Button Content="⌂   Dashboard" Tag="0" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="▣   Display" Tag="1" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="▤   Pages" Tag="2" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="♫   Winamp" Tag="3" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="▦   Hardware" Tag="4" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="✽   Fan Control" Tag="5" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="⚙   Settings" Tag="6" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="∿   Diagnostics" Tag="7" Click="Navigation_Click" Style="{StaticResource NavButtonStyle}"/>

                    <Separator Margin="4,18,4,16"/>

                    <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock x:Name="TransportSummaryText"
                                   Text="Virtual LIS2"
                                   Foreground="#E8EAED"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,8">
                            <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0"/>
                            <TextBlock Text="Connected" Foreground="{StaticResource AccentBrush}"/>
                        </StackPanel>
                        <Button Content="Change..."
                                Tag="6"
                                Click="Navigation_Click"
                                HorizontalAlignment="Left"
                                MinWidth="110"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="4,12,0,10">
                    <Separator Margin="0,0,0,12"/>
                    <TextBlock Text="ⓘ  LIS2 Control Center" Foreground="#D7DCE2"/>
                    <TextBlock Text="Development build" FontSize="11" Foreground="#737C88" Margin="25,3,0,8"/>
                    <TextBlock Text="◉  GitHub" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,5"/>
                    <TextBlock Text="ⓘ  About" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="SectionTitleText" Text="Dashboard" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SectionSubtitleText"
                               Text="Overview and quick access to the most important functions."
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <Border x:Name="ConnectionBadge"
                        DockPanel.Dock="Right"
                        Background="#1D3325"
                        CornerRadius="14"
                        Padding="14,9"
                        HorizontalAlignment="Right">
                    <TextBlock x:Name="ConnectionText" Text="Disconnected" Foreground="#B9F7C8" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>

            <TabControl x:Name="MainTabs"
                        Grid.Row="1"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionChanged="MainTabs_SelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>

                <!-- Dashboard -->
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                        <Border Background="#030A06" BorderBrush="#324239" BorderThickness="1" CornerRadius="6" Padding="24,20">
                                            <StackPanel>
                                                <TextBlock x:Name="PreviewLine1"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="31"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                                <TextBlock x:Name="PreviewLine2"
                                                           Text="                    "
                                                           FontFamily="Consolas"
                                                           FontSize="31"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="2">
                                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="System Status" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="VirtualStateText"
                                                       Text="State available when Virtual transport is active."
                                                       Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource CardBorderStyle}">
                                        <StackPanel>
                                            <TextBlock Text="Quick Links" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                            <Button Content="Open Display Controls" Tag="1" Click="Navigation_Click" Margin="0,0,0,6"/>
                                            <Button Content="Open Fan Control" Tag="5" Click="Navigation_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Recent Log" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBox x:Name="DashboardLogMirror"
                                             Height="190"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#0C0F13"
                                             Foreground="#D8DEE4"
                                             VerticalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#141A20"
                                    BorderBrush="#222A32"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="12,9">
                                <TextBlock Foreground="{StaticResource MutedBrush}"
                                           Text="💡  Tip: Use the navigation on the left to access display settings, page editor, Winamp integration, hardware and fan control."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Display -->
                <TabItem Header="Display">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Quick Display Test" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1" Margin="0,0,10,9" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,9"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="Send" Click="SendLine1_Click" Margin="0,0,0,9"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2" Margin="0,0,10,9" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,9"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="Send" Click="SendLine2_Click" Margin="0,0,0,9"/>

                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                                            <Button Content="Render both lines" Click="RenderBoth_Click" Margin="0,0,7,0"/>
                                            <Button Content="Clear" Click="Clear_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
                                    <WrapPanel>
                                        <Button Content="100%" Tag="100" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="75%" Tag="75" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="50%" Tag="50" Click="Brightness_Click" Margin="0,0,7,0"/>
                                        <Button Content="25%" Tag="25" Click="Brightness_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pages -->
                <TabItem Header="Pages">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Style="{StaticResource CardBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <ListBox x:Name="PagesListBox" Height="310" SelectionChanged="PagesListBox_SelectionChanged"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Add" Click="AddPage_Click" Margin="0,0,7,0"/>
                                        <Button Content="Delete" Click="DeletePage_Click"/>
                                    </StackPanel>
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 1" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageLine1TextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Line 2" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageLine2TextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Duration (s)" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageDurationTextBox" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Visible when" Margin="0,0,10,10" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PageVisibilityTextBox"
                                             Grid.Row="4" Grid.Column="1"
                                             Margin="0,0,0,10"
                                             ToolTip="Example: Winamp.State=Playing"/>

                                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Save page" Click="SavePage_Click" Margin="0,0,7,0"/>
                                        <Button Content="Test event (5 s)" Click="TestEvent_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <!-- Winamp -->
                <TabItem Header="Winamp">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Winamp Integration" FontWeight="SemiBold" FontSize="18"/>
                                    <TextBlock Text="The host listens on \\.\pipe\LIS2ControlCenter.Winamp."
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,8,0,0"/>
                                    <TextBlock Text="The native gen_lis2.dll sends artist, title, album, playback state, position and timing."
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Available page variables" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock FontFamily="Consolas"
                                               Text="{}{Winamp.State}   {Winamp.Artist}   {Winamp.Title}   {Winamp.Album}&#x0a;{Winamp.Elapsed}   {Winamp.Duration}   {Winamp.PlaylistPosition}   {Winamp.PlaylistCount}"
                                               Foreground="#D8DEE4"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Hardware -->
                <TabItem Header="Hardware">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Hardware Monitoring" FontWeight="SemiBold" FontSize="18"/>
                                    <TextBlock Text="LibreHardwareMonitor provides CPU, GPU, memory, storage, motherboard and fan sensor values."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Sensor usage" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                    <TextBlock Text="Hardware values are available to page templates with the Hardware.* prefix and can be selected as fan-control sensors."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"/>
                                    <Button Content="Refresh fan sensor list" Click="RefreshFanSensors_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Fan Control -->
                <TabItem Header="Fan Control">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Left"/>
                                        <CheckBox x:Name="AutomaticFanControlCheckBox"
                                                  Content="Automatic control"
                                                  Checked="AutomaticFanControlChanged"
                                                  Unchecked="AutomaticFanControlChanged"
                                                  DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="Fan1TextBox" Grid.Column="1" Text="100" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="2" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="Fan2TextBox" Grid.Column="3" Text="100" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="4" Text="3" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="Fan3TextBox" Grid.Column="5" Text="100" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="6" Text="4" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox x:Name="Fan4TextBox" Grid.Column="7" Text="100" Margin="0,0,12,0"/>
                                        <Button Grid.Column="8" Content="Apply" Click="Fans_Click" HorizontalAlignment="Left"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Channels" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                                        <ListBox x:Name="FanChannelsListBox" Height="290" SelectionChanged="FanChannelsListBox_SelectionChanged"/>
                                        <Button Content="Refresh sensors"
                                                Click="RefreshFanSensors_Click"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <Grid Grid.Column="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanNameTextBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Mode" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FanModeComboBox" Grid.Row="0" Grid.Column="4" Margin="0,0,0,10">
                                            <ComboBoxItem Content="Fixed"/>
                                            <ComboBoxItem Content="Curve"/>
                                            <ComboBoxItem Content="Follow"/>
                                            <ComboBoxItem Content="External"/>
                                            <ComboBoxItem Content="Off"/>
                                        </ComboBox>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sensor" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <ComboBox x:Name="FanSensorComboBox"
                                                  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
                                                  IsEditable="True"
                                                  IsTextSearchEnabled="True"
                                                  Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fixed %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanFixedTextBox" Grid.Row="2" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Minimum %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanMinimumTextBox" Grid.Row="2" Grid.Column="4" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Maximum %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanMaximumTextBox" Grid.Row="3" Grid.Column="1" Width="90" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="Fail-safe %" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanFailSafeTextBox" Grid.Row="3" Grid.Column="4" Margin="0,0,0,10"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Curve" Margin="0,0,8,10" VerticalAlignment="Center"/>
                                        <TextBox x:Name="FanCurveTextBox"
                                                 Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="4"
                                                 Margin="0,0,0,10"
                                                 ToolTip="Format: 40:40;60:80;75:100"/>

                                        <CheckBox x:Name="FanAllowStopCheckBox"
                                                  Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                                  Content="Allow 0% / stop"
                                                  Margin="0,0,0,10"/>

                                        <Button Grid.Row="6" Grid.Column="1"
                                                Content="Save fan channel"
                                                Click="SaveFanChannel_Click"
                                                HorizontalAlignment="Left"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Settings -->
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Device / Transport" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="190"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Transport" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="TransportModeComboBox" Grid.Column="1" SelectionChanged="TransportModeChanged" Margin="0,0,16,0">
                                            <ComboBoxItem Content="Virtual" IsSelected="True"/>
                                            <ComboBoxItem Content="Serial"/>
                                        </ComboBox>
                                        <TextBlock Grid.Column="2" Text="COM port" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <ComboBox x:Name="PortComboBox" Grid.Column="3" IsEnabled="False" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                                            <Button Content="Refresh" Click="RefreshPorts_Click" Margin="0,0,7,0"/>
                                            <Button Content="Apply / reconnect" Click="ApplyDeviceSettings_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Windows" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="StartWithWindowsCheckBox"
                                              Content="Start LIS2 Control Center with Windows (minimized to tray)"
                                              Checked="StartWithWindowsChanged"
                                              Unchecked="StartWithWindowsChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Diagnostics -->
                <TabItem Header="Diagnostics">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Diagnostics Snapshot" FontWeight="SemiBold" FontSize="18" DockPanel.Dock="Left"/>
                                        <Button Content="Refresh" Click="RefreshDiagnostics_Click" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <TextBox x:Name="DiagnosticsTextBox"
                                             Height="280"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#0C0F13"
                                             Foreground="#D8DEE4"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel>
                                    <TextBlock Text="Protocol Log" FontWeight="SemiBold" FontSize="18" Margin="0,0,0,10"/>
                                    <TextBox x:Name="LogTextBox"
                                             Height="260"
                                             IsReadOnly="True"
                                             FontFamily="Consolas"
                                             Background="#0C0F13"
                                             Foreground="#D8DEE4"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
