<Window x:Class="LIS2.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LIS2 Control Center Help"
        Width="1080" Height="780"
        MinWidth="840" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="HelpTitleText" Text="Help &amp; reference" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="HelpSubtitleText" Text="Instructions, configuration reference and display-variable examples."
                           Foreground="{DynamicResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="Close"
                    Padding="18,8"
                    VerticalAlignment="Center"
                    Click="Close_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="8">
                <ListBox x:Name="SectionsListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectionChanged="SectionsListBox_SelectionChanged"/>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="4">
                <FlowDocumentScrollViewer x:Name="HelpViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsSelectionEnabled="True"
                                          Padding="18">
                    <FlowDocument x:Name="HelpDocument"
                                  PagePadding="0,0,20,0"
                                  FontFamily="Segoe UI"
                                  FontSize="14"
                                  Foreground="{DynamicResource TextBrush}"/>
                </FlowDocumentScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
