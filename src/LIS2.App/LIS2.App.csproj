<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>LIS2ControlCenter</AssemblyName>
    <ApplicationIcon>$(MSBuildProjectDirectory)\obj\LIS2.ico</ApplicationIcon>
    <RootNamespace>LIS2.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LIS2.Core\LIS2.Core.csproj" />
    <ProjectReference Include="..\LIS2.Display\LIS2.Display.csproj" />
    <ProjectReference Include="..\LIS2.Sources\LIS2.Sources.csproj" />
    <ProjectReference Include="..\LIS2.Fans\LIS2.Fans.csproj" />
    <ProjectReference Include="..\LIS2.Winamp\LIS2.Winamp.csproj" />
    <ProjectReference Include="..\LIS2.WindowsMedia\LIS2.WindowsMedia.csproj" />
    <ProjectReference Include="..\LIS2.WmpLegacy\LIS2.WmpLegacy.csproj" />
  </ItemGroup>
  <Target Name="GenerateLis2ApplicationIcon" BeforeTargets="PrepareForBuild" Inputs="$(MSBuildProjectDirectory)\TrayIconService.cs;$(MSBuildProjectDirectory)\GenerateAppIcon.ps1" Outputs="$(ApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\GenerateAppIcon.ps1&quot; -Source &quot;$(MSBuildProjectDirectory)\TrayIconService.cs&quot; -Destination &quot;$(ApplicationIcon)&quot;" />
  </Target>
</Project>
