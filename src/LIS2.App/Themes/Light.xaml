<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Name="LightTheme">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F7F9"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#F0F3F6"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#D5DBE2"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#F7F9FB"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#EDF1F5"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#E2E8EE"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#D4DCE5"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C4CCD5"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#9DA8B4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#171A1F"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#5E6875"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9AA3AD"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#EFF2F5"/>
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#D7DCE2"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#159447"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#DDF4E5"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#DDF4E5"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#0E5D2C"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C9362B"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#F0F3F6"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#242A31"/>
    <SolidColorBrush x:Key="VfdBackgroundBrush" Color="#07110A"/>
    <SolidColorBrush x:Key="VfdBorderBrush" Color="#BCD2C2"/>
    <SolidColorBrush x:Key="StatusBadgeBrush" Color="#DDF4E5"/>
    <SolidColorBrush x:Key="StatusBadgeTextBrush" Color="#0E5D2C"/>
    <SolidColorBrush x:Key="TipBackgroundBrush" Color="#EEF5F0"/>
    <SolidColorBrush x:Key="TipBorderBrush" Color="#D5E6DA"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#CDD3DA"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#C4CCD5"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#171A1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#EDF1F5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#171A1F"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#C4CCD5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#9AA3AD"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DDF4E5"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0E5D2C"/>
</ResourceDictionary>
