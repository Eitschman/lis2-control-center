<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1114"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#171B20"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#171B20"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#1C2229"/>
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#343A42"/>
    <SolidColorBrush x:Key="InputBrush" Color="#11151A"/>
    <SolidColorBrush x:Key="InputHoverBrush" Color="#171C22"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#353B45"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#414955"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#242A31"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4A515C"/>
    <SolidColorBrush x:Key="ButtonHoverBorderBrush" Color="#626C79"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AAB2BD"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F7884"/>
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="#15191E"/>
    <SolidColorBrush x:Key="DisabledBorderBrush" Color="#2C3239"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#69EE8A"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#0B2012"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#173B25"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#214D31"/>
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#D7FFE1"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FF7B72"/>
    <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0C0F13"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#D8DEE4"/>
    <SolidColorBrush x:Key="VfdBackgroundBrush" Color="#123B8A"/>
    <SolidColorBrush x:Key="VfdBorderBrush" Color="#5D8FE8"/>
    <SolidColorBrush x:Key="VfdTextBrush" Color="#F7FBFF"/>
    <SolidColorBrush x:Key="StatusBadgeBrush" Color="#1D3325"/>
    <SolidColorBrush x:Key="StatusBadgeTextBrush" Color="#B9F7C8"/>
    <SolidColorBrush x:Key="TipBackgroundBrush" Color="#141A20"/>
    <SolidColorBrush x:Key="TipBorderBrush" Color="#222A32"/>
    <SolidColorBrush x:Key="SeparatorBrush" Color="#59616B"/>
    <SolidColorBrush x:Key="TooltipBackgroundBrush" Color="#20262D"/>
    <SolidColorBrush x:Key="TooltipBorderBrush" Color="#47505B"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#11151A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252B33"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#3A414B"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#0E1114"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#6F7884"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#214D31"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F3F4F6"/>
</ResourceDictionary>
