<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LIS2.App.Avalonia.MainWindow"
        Title="LIS2 Control Center"
        Width="1320" Height="900" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="250,*">
    <Border Grid.Column="0" Background="#182431" BorderBrush="#354351" BorderThickness="0,0,1,0">
      <Grid Margin="18" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="LIS2 CONTROL CENTER" FontSize="16" FontWeight="Bold" Margin="4,18,0,24" Foreground="White" />
        <StackPanel Grid.Row="1" Spacing="8">
          <ListBox Name="Navigation" SelectedIndex="0">
            <ListBoxItem Content="⌂    Dashboard" />
            <ListBoxItem Content="▣    Display" />
            <ListBoxItem Content="▤    Pages" />
            <ListBoxItem Content="♫    Media" />
            <ListBoxItem Content="⚠    Events" />
            <ListBoxItem Content="▦    Hardware" />
            <ListBoxItem Content="✽    Fan Control" />
            <ListBoxItem Content="⚙    Settings" />
            <ListBoxItem Content="∿    Diagnostics" />
            <ListBoxItem Content="⌂    Home Assistant" />
          </ListBox>
          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />
          <TextBlock Name="TransportSummaryText" Text="Virtual LIS2" TextWrapping="Wrap" Margin="4,0,0,0" />
          <TextBlock Name="VirtualStatus" Text="Disconnected" Margin="4,4,0,0" />
          <Button Name="VirtualConnect" Content="Connect virtual LIS2" HorizontalAlignment="Left" />
          <Button Name="VirtualDisconnect" Content="Disconnect" IsEnabled="False" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="4,12,0,10" Spacing="7">
          <Separator />
          <TextBlock Text="ⓘ  LIS2 Control Center" />
          <TextBlock Text="◉  GitHub" Opacity="0.65" />
          <TextBlock Text="ⓘ  About" Opacity="0.65" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel Grid.Column="0" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Name="SectionTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
            <Button Content="?" Width="32" Height="32" ToolTip.Tip="Help for this page" />
          </StackPanel>
          <TextBlock Name="SectionDescription" Text="Overview and quick access to the most important functions." Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="#354351" CornerRadius="14" Padding="14,9" VerticalAlignment="Top">
          <TextBlock Name="ConnectionText" Text="Disconnected" FontWeight="SemiBold" />
        </Border>
      </Grid>
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="3*,14,2*">
            <Border Grid.Column="0" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" />
                <Border Background="#07190E" BorderBrush="#33523D" BorderThickness="1" CornerRadius="6" Padding="24,20">
                  <StackPanel>
                    <TextBlock Name="PreviewLine1" Text="                    " FontFamily="Consolas" FontSize="31" Foreground="#70EF86" />
                    <TextBlock Name="PreviewLine2" Text="                    " FontFamily="Consolas" FontSize="31" Foreground="#70EF86" />
                  </StackPanel>
                </Border>
                <Button Name="VirtualDemo" Content="Send demo display" IsEnabled="False" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Spacing="14">
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="System Status" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Name="VirtualStateText" Text="State available when Virtual transport is active." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Quick Links" FontSize="16" FontWeight="SemiBold" />
                  <Button Name="OpenDisplayControls" Content="Open Display Controls" />
                  <Button Name="OpenFanControl" Content="Open Fan Control" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,12,Auto,14,Auto">
                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 1" VerticalAlignment="Center" />
                <Slider Name="DashboardFan1Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan1Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 2" VerticalAlignment="Center" />
                <Slider Name="DashboardFan2Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan2Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 3" VerticalAlignment="Center" />
                <Slider Name="DashboardFan3Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan3Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 4" VerticalAlignment="Center" />
                <Slider Name="DashboardFan4Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan4Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Name="DashboardFansApply" Content="Apply" HorizontalAlignment="Right" MinWidth="110" IsEnabled="False" />
              </Grid>
              <TextBlock Text="Fan outputs are read-only until the safety-reviewed fan runtime is ported." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="6" Padding="12,9">
            <TextBlock Text="💡  Tip: Use the navigation on the left to access display settings, page editor, Winamp integration, hardware and fan control." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
