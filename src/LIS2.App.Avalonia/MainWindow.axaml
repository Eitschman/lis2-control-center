<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LIS2.App.Avalonia"
        x:Class="LIS2.App.Avalonia.MainWindow"
        Title="LIS2 Control Center"
        Width="1200" Height="700" MinWidth="850" MinHeight="480"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="250,*">
    <Border Grid.Column="0" Background="#182431" BorderBrush="#354351" BorderThickness="0,0,1,0">
      <Grid Margin="14" RowDefinitions="Auto,*,Auto"><Grid.Styles><Style Selector="TextBlock"><Setter Property="Foreground" Value="#F1F5F9"/></Style><Style Selector="Button"><Setter Property="Foreground" Value="#F1F5F9"/></Style></Grid.Styles>
        <TextBlock Grid.Row="0" Text="LIS2 CONTROL CENTER" FontSize="16" FontWeight="Bold" Margin="4,18,0,24" Foreground="White" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8">
          <StackPanel Name="NavigationPanel" Spacing="2">
            <Button Name="NavButton0" Tag="0" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M2,8 L8,2 L14,8 M4,7 L4,14 L12,14 L12,7"/><TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton1" Tag="1" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M2,3 L14,3 L14,13 L2,13 Z M5,6 L11,6 M5,9 L11,9"/><TextBlock Grid.Column="1" Text="Display" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton2" Tag="2" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M3,2 L13,2 L13,14 L3,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11"/><TextBlock Grid.Column="1" Text="Pages" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton3" Tag="3" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M5,12 L5,3 L13,2 L13,10 M5,5 L13,4"/><TextBlock Grid.Column="1" Text="Media" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton4" Tag="4" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M8,2 L15,14 L1,14 Z M8,6 L8,10 M8,12 L8,12.5"/><TextBlock Grid.Column="1" Text="Events" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton5" Tag="5" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M2,3 L14,3 L14,13 L2,13 Z M6,3 L6,13 M10,3 L10,13"/><TextBlock Grid.Column="1" Text="Hardware" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton6" Tag="6" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M8,2 L8,14 M2,8 L14,8 M4,4 L12,12 M12,4 L4,12"/><TextBlock Grid.Column="1" Text="Fan Control" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton7" Tag="7" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M6,2 L10,2 L11,4 L13,5 L14,8 L13,11 L11,12 L10,14 L6,14 L5,12 L3,11 L2,8 L3,5 L5,4 Z M8,6 L8,10"/><TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton8" Tag="8" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M2,10 Q5,3 8,8 T14,6 M2,13 L14,13"/><TextBlock Grid.Column="1" Text="Diagnostics" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton9" Tag="9" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#F1F5F9" StrokeThickness="1.5" Data="M2,8 L8,2 L14,8 M4,7 L4,14 L12,14 L12,7 M6,10 L10,10"/><TextBlock Grid.Column="1" Text="Home Assistant" VerticalAlignment="Center"/></Grid></Button>
          </StackPanel>
          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />
          <TextBlock Name="TransportSummaryText" Text="Virtual LIS2" TextWrapping="Wrap" Margin="4,0,0,4" />
          <Button Name="OpenTransportSettings" Content="Change..." HorizontalAlignment="Left" MinWidth="110" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="4,12,0,10" Spacing="7">
          <Separator />
          <TextBlock Text="LIS2 Control Center · Preview" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel Grid.Column="0" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Name="SectionTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
            <TextBlock Text="Preview" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Name="SectionDescription" Text="Overview and quick access to the most important functions." Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="#354351" CornerRadius="14" Padding="14,9" VerticalAlignment="Top">
          <TextBlock Name="ConnectionText" Text="Disconnected" FontWeight="SemiBold" Foreground="White" />
        </Border>
      </Grid>
      <ScrollViewer Name="DashboardView" Grid.Row="1">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="3*,14,2*">
            <Border Grid.Column="0" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" />
                <Border Background="#123B8A" BorderBrush="#5D8FE8" BorderThickness="1" CornerRadius="6"
                        Width="402" Height="112" HorizontalAlignment="Left" ClipToBounds="True" Padding="8,12">
                  <StackPanel Width="384" HorizontalAlignment="Left" Spacing="0">
                    <TextBlock Name="PreviewLine1" Text="                    " Width="384" FontFamily="Consolas" FontSize="30" Foreground="#F7FBFF" TextWrapping="NoWrap" />
                    <TextBlock Name="PreviewLine2" Text="                    " Width="384" FontFamily="Consolas" FontSize="30" Foreground="#F7FBFF" TextWrapping="NoWrap" />
                  </StackPanel>
                </Border>
                <Button Name="VirtualDemo" Content="Send demo display" IsEnabled="False" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Spacing="14">
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="System Status" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Name="VirtualStateText" Text="State available when Virtual transport is active." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Quick Links" FontSize="16" FontWeight="SemiBold" />
                  <Button Name="OpenDisplayControls" Content="Open Display Controls" />
                  <Button Name="OpenFanControl" Content="Open Fan Control" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,12,Auto,14,Auto">
                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 1" VerticalAlignment="Center" />
                <Slider Name="DashboardFan1Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan1Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 2" VerticalAlignment="Center" />
                <Slider Name="DashboardFan2Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan2Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 3" VerticalAlignment="Center" />
                <Slider Name="DashboardFan3Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan3Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 4" VerticalAlignment="Center" />
                <Slider Name="DashboardFan4Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan4Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Name="DashboardFansApply" Content="Apply" HorizontalAlignment="Right" MinWidth="110" IsEnabled="False" />
              </Grid>
              <TextBlock Text="Fan outputs are read-only until the safety-reviewed fan runtime is ported." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="6" Padding="12,9">
            <TextBlock Text="💡  Tip: Use the navigation on the left to access display settings, page editor, Winamp integration, hardware and fan control." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    <ScrollViewer Name="DisplayView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Quick Display Test" FontWeight="SemiBold" FontSize="16" />
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Line 1" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,9" />
              <Button Name="SendLine1" Grid.Row="0" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <TextBlock Grid.Row="1" Text="Line 2" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,9" />
              <Button Name="SendLine2" Grid.Row="1" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="7">
                <Button Name="RenderBoth" Content="Render both lines" />
                <Button Name="ClearDisplay" Content="Clear" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Character ROM / Special Characters" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Native LIS2 characters use the uPD16314 ROM. Test the mapped Unicode set or inspect raw ROM bytes on the real display." TextWrapping="Wrap" Opacity="0.7" />
            <WrapPanel>
              <Button Name="SendSpecialCharacterTest" Content="Send special-character test" Margin="0,0,8,0" />
              <TextBlock Text="Ä Ö Ü  ä ö ü  ß  °  µ  ±  £  ×  ÷  ← →  Ω π Σ √ ∞" FontFamily="Consolas" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="ROM start byte" VerticalAlignment="Center" />
              <TextBox Name="CharacterRomStartTextBox" Text="80" Width="90" MaxLength="2" />
              <Button Name="CharacterRomPrevious" Content="Previous" />
              <Button Name="SendCharacterRomRange" Content="Send 40 bytes" />
              <Button Name="CharacterRomNext" Content="Next" />
              <TextBlock Name="CharacterRomRangeText" Text="80-A7" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Custom Characters / CG Builder" FontWeight="SemiBold" FontSize="16" />
            <CheckBox Name="ProgramGlyphsOnConnect" Content="Program saved glyphs on connect" />
            <Grid ColumnDefinitions="190,220,24,*">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Slot" />
                <ComboBox Name="GlyphSlot" SelectedIndex="0"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" /></ComboBox>
                <TextBlock Text="Name" />
                <TextBox Name="GlyphName" Text="Glyph 1" />
                <TextBlock Text="Template key" />
                <TextBlock Name="GlyphTemplateKey" Text="{}{Glyph.1}" FontFamily="Consolas" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="5x8 bitmap (8 rows)" />
                <TextBox Name="GlyphBitmapEditor" AcceptsReturn="True" Height="150" Text="00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000" />
              </StackPanel>
              <Border Grid.Column="3" Background="#07190E" CornerRadius="5" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Name="GlyphPixelPreview" Text="·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····" FontFamily="Consolas" FontSize="22" Foreground="#F7FBFF" />
                  <TextBlock Text="20x2 template preview" />
                </StackPanel>
              </Border>
            </Grid>
            <WrapPanel>
              <Button Name="SaveGlyph" Content="Save glyph" />
              <Button Name="SendGlyphSlot" Content="Send slot to LIS2" />
              <Button Name="SendAllGlyphs" Content="Send all 8 slots" />
              <Button Name="LoadGlyphSet" Content="Load set..." />
              <Button Name="SaveGlyphSet" Content="Save set..." />
              <Button Name="LoadExampleGlyphs" Content="Load examples" />
            </WrapPanel>
            <TextBlock Text="{}Use {Glyph.Name} or {Glyph.1} through {Glyph.8} in page templates." Opacity="0.7" />
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="16" />
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Name="Brightness100" Content="100%" />
              <Button Name="Brightness75" Content="75%" />
              <Button Name="Brightness50" Content="50%" />
              <Button Name="Brightness25" Content="25%" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="PagesView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <Grid ColumnDefinitions="230,16,*">
            <StackPanel Grid.Column="0" Spacing="9">
              <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16" />
              <ListBox Name="PagesList" Height="380" />
              <WrapPanel>
                <Button Name="PageAdd" Content="Add" Margin="0,0,7,7" />
                <Button Name="PageDuplicate" Content="Duplicate" Margin="0,0,7,7" />
                <Button Name="PageDelete" Content="Delete" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageImport" Content="Load pages..." />
                <Button Name="PageExport" Content="Save pages..." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageUp" Content="↑  Move up" />
                <Button Name="PageDown" Content="↓  Move down" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="9">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Name" />
                <TextBox Name="PageName" Grid.Row="0" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="Line 1" />
                <TextBox Name="PageLine1" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="Line 2" />
                <TextBox Name="PageLine2" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="Duration (s)" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBox Name="PageDuration" Width="90" />
                  <TextBlock Text="Refresh (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageRefresh" Width="90" />
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Visible when" />
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Name="PageConditionKey" Width="185" Watermark="Template key" />
                    <ComboBox Name="PageConditionOperator" Width="85">
                      <ComboBoxItem Content="=" /><ComboBoxItem Content="!=" />
                      <ComboBoxItem Content="&gt;" /><ComboBoxItem Content="&gt;=" />
                      <ComboBoxItem Content="&lt;" /><ComboBoxItem Content="&lt;=" />
                    </ComboBox>
                    <TextBox Name="PageConditionValue" Width="110" Watermark="Value" />
                    <Button Name="PageApplyCondition" Content="Apply condition" />
                  </StackPanel>
                  <TextBox Name="PageVisibility" Watermark="Raw visibility expression" />
                  <TextBlock Name="PageConditionStatus" Opacity="0.65" />
                </StackPanel>
                <TextBlock Grid.Row="5" Text="Overflow" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox Name="PageOverflow1" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                  <ComboBox Name="PageOverflow2" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                </StackPanel>
                <TextBlock Grid.Row="6" Text="Scroll timing" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Step (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageScrollStep" Width="75" />
                  <TextBlock Text="Edge pause (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageScrollPause" Width="75" />
                </StackPanel>
                <TextBlock Grid.Row="7" Text="Enabled" />
                <CheckBox Name="PageEnabled" Grid.Row="7" Grid.Column="1" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox Name="PageVariablePicker" Width="220" />
                <Button Name="PageInsertLine1" Content="Insert into line 1" />
                <Button Name="PageInsertLine2" Content="Insert into line 2" />
                <Button Name="PageRefreshVariables" Content="Refresh variables" />
              </StackPanel>
              <TextBlock Name="PageVariableStatus" Opacity="0.65" />
              <TextBlock Name="PagePlaybackStatus" Text="Sequence stopped" Opacity="0.75" />
              <TextBlock Text="Live preview" FontWeight="SemiBold" />
              <Border Background="#123B8A" BorderBrush="#5D8FE8" BorderThickness="1" CornerRadius="6" Padding="18,12" HorizontalAlignment="Left">
                <StackPanel>
                  <TextBlock Name="PagePreview1" FontFamily="Consolas" FontSize="26" Foreground="#F7FBFF" />
                  <TextBlock Name="PagePreview2" FontFamily="Consolas" FontSize="26" Foreground="#F7FBFF" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageSave" Content="Save page" />
                <Button Name="PageTest" Content="Test event (5 s)" />
                <Button Name="PagePlaybackStart" Content="Start sequence" />
                <Button Name="PagePlaybackStop" Content="Stop sequence" IsEnabled="False" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="MediaView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border Name="WindowsMediaCard" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Windows Media Player" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Name="WindowsMediaStatus" Text="Disconnected"/>
            <TextBlock Name="WindowsMediaTitle" Text="Nothing playing" FontSize="22"/>
            <TextBlock Name="WindowsMediaArtist"/>
            <TextBlock Name="WindowsMediaAlbum"/>
            <TextBlock Name="WindowsMediaPlayback"/>
            <TextBlock Name="WindowsMediaTime"/>
            <Button Name="WindowsMediaPage" Content="Create playback page" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Name="LinuxMediaCard" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Linux MPRIS players (playerctl)" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Name="LinuxMediaStatus" Text="Disconnected"/>
            <TextBlock Name="LinuxMediaTitle" Text="Nothing playing"/>
            <TextBlock Name="LinuxMediaArtist"/>
            <TextBlock Name="LinuxMediaAlbum"/>
            <TextBlock Name="LinuxMediaPlayback"/>
            <TextBlock Name="LinuxMediaDuration"/>
            <Button Name="LinuxMediaPage" Content="Create playback page"/>
          </StackPanel>
        </Border>
        <Border Name="WinampMediaCard" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Winamp" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Name="WinampMediaStatus" Text="Disconnected"/>
            <TextBlock Name="WinampMediaTitle" Text="Nothing playing" FontSize="22"/>
            <TextBlock Name="WinampMediaArtist" Text="Waiting for Winamp..."/>
            <TextBlock Name="WinampMediaAlbum"/>
            <TextBlock Name="WinampMediaPlayback"/>
            <TextBlock Name="WinampMediaTime"/>
            <TextBlock Name="WinampMediaTelemetry"/>
            <Button Name="WinampMediaPage" Content="Create playback page" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Name="WmpLegacyMediaCard" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Windows Media Player Legacy" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Name="WmpLegacyMediaStatus" Text="Disconnected"/>
            <TextBlock Name="WmpLegacyMediaTitle" Text="Nothing playing" FontSize="22"/>
            <TextBlock Name="WmpLegacyMediaArtist" Text="Waiting for legacy player..."/>
            <TextBlock Name="WmpLegacyMediaAlbum"/>
            <TextBlock Name="WmpLegacyMediaPlayback"/>
            <TextBlock Name="WmpLegacyMediaTime"/>
            <TextBlock Name="WmpLegacyMediaTelemetry"/>
            <Button Name="WmpLegacyMediaPage" Content="Create playback page" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="HomeAssistantView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Connection" FontWeight="SemiBold" FontSize="18" />
            <CheckBox Name="HaEnabled" Content="Enable Home Assistant" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="URL" VerticalAlignment="Center" />
              <TextBox Name="HaUrl" Width="310" Watermark="http://homeassistant.local:8123" />
              <TextBlock Text="Token" VerticalAlignment="Center" />
              <TextBox Name="HaToken" Width="240" PasswordChar="*" Watermark="Long-lived access token" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="HaTest" Content="Test connection" />
              <Button Name="HaConnect" Content="Save / reconnect" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Home Assistant entities" FontWeight="SemiBold" FontSize="18" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="HaEntityFilter" Width="240" Watermark="Search entity ID, friendly name or alias" />
              <ComboBox Name="HaEntityPicker" Width="370" />
              <ComboBox Name="HaDomainFilter" Width="140" />
            </StackPanel>
            <TextBlock Name="HaStatus" Text="Not configured" TextWrapping="Wrap" />
            <TextBlock Text="Selected entity" FontWeight="SemiBold" />
            <TextBlock Name="HaSelectedEntity" Text="Select an entity above." />
            <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="Alias" VerticalAlignment="Center" /><TextBox Name="HaAlias" Width="220" /><CheckBox Name="HaFavorite" Content="Favorite" /><Button Name="HaSaveEntity" Content="Save entity" /></StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="HaCopyKey" Content="Copy key" /><Button Name="HaCreatePage" Content="Create display page" /></StackPanel>
            <TextBlock Text="Attributes" FontWeight="SemiBold" />
            <ListBox Name="HaAttributes" Height="150" />
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="HaCopyAttributeKey" Content="Copy key" /><Button Name="HaCreateAttributePage" Content="Create attribute page" /></StackPanel>

          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="FanControlView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Fan Outputs" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Physical fan outputs require explicit authorization. Configuration and previews do not send hardware commands." TextWrapping="Wrap" />
            <CheckBox Name="FanAutomatic" Content="Automatic control" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Channel" VerticalAlignment="Center" />
              <ComboBox Name="FanChannelPicker" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Fan 1" /><ComboBoxItem Content="Fan 2" />
                <ComboBoxItem Content="Fan 3" /><ComboBoxItem Content="Fan 4" />
              </ComboBox>
              <TextBlock Text="Mode" VerticalAlignment="Center" />
              <ComboBox Name="FanModePicker" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Fixed" /><ComboBoxItem Content="Curve" />
                <ComboBoxItem Content="Follow" /><ComboBoxItem Content="External" />
                <ComboBoxItem Content="Off" />
              </ComboBox>
            </StackPanel>
            <Grid ColumnDefinitions="180,240" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Name" /><TextBox Grid.Row="0" Grid.Column="1" Name="FanName" />
              <TextBlock Grid.Row="1" Text="Sensor key" /><TextBox Grid.Row="1" Grid.Column="1" Name="FanSensorKey" />
              <TextBlock Grid.Row="2" Text="Fixed percent" /><TextBox Grid.Row="2" Grid.Column="1" Name="FanFixed" />
              <TextBlock Grid.Row="3" Text="Minimum / maximum" />
              <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBox Name="FanMinimum" Width="110" /><TextBox Name="FanMaximum" Width="110" />
              </StackPanel>
              <TextBlock Grid.Row="4" Text="Fail-safe percent" /><TextBox Grid.Row="4" Grid.Column="1" Name="FanFailSafe" />
              <TextBlock Grid.Row="5" Text="Hysteresis (C)" /><TextBox Grid.Row="5" Grid.Column="1" Name="FanHysteresis" />
              <TextBlock Grid.Row="6" Text="Allow stop" /><CheckBox Grid.Row="6" Grid.Column="1" Name="FanAllowStop" />
            </Grid>
            <TextBlock Text="Curve points (temperature=percent, one per line)" />
            <TextBox Name="FanCurve" Width="240" Height="110" HorizontalAlignment="Left" AcceptsReturn="True" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Simulated sensor temperature" VerticalAlignment="Center" />
              <TextBox Name="FanSimulatedTemperature" Width="90" Text="50" />
              <Button Name="FanSave" Content="Save fan channel" />
              <Button Name="FanPreview" Content="Simulate all four channels" />
            </StackPanel>
            <TextBlock Text="System temperature sensors (Linux hwmon, read-only)" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="FanReadSensors" Content="List detected sensors" />
              <Button Name="FanLivePreview" Content="Preview with real sensor values (dry run)" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="FanMonitorStart" Content="Start continuous sensor preview (dry run)" />
              <Button Name="FanMonitorStop" Content="Stop preview" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Virtual LIS2 protocol integration (no physical hardware)" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="FanVirtualStart" Content="Start virtual four-fan controller" />
              <Button Name="FanVirtualStop" Content="Stop and restore safety frame" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Physical LIS2 fans: explicit per-connection authorization (experimental)" FontWeight="SemiBold" />
            <TextBlock Text="Only use with a connected LIS2 and verified fan wiring. The first fan command sets all four fans to 100%. Stopping restores 100%. This feature is never auto-enabled by saved settings." TextWrapping="Wrap" />
            <CheckBox Name="FanHardwareConsent" Content="I explicitly authorize physical fan output for this connection" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Name="FanHardwareStart" Content="Enable physical four-fan control" IsEnabled="False" />
              <Button Name="FanHardwareStop" Content="Stop and restore 100% safety frame" IsEnabled="False" />
            </StackPanel>
            <TextBlock Name="FanSensorStatus" Text="Sensor discovery has not run." TextWrapping="Wrap" />
            <TextBlock Name="FanPreviewStatus" Text="Physical fan output disabled." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
      <ScrollViewer Name="HardwareView" Grid.Row="1" IsVisible="False">
        <StackPanel Spacing="12">
          <TextBlock Text="Hardware temperature sensors" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Text="Read-only sensors from the current operating system. Refresh to capture a new snapshot; no LIS2 hardware commands are sent." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="HardwareRefresh" Content="Refresh sensors" />
            <Button Name="HardwareAutoRefresh" Content="Start live updates" />
            <TextBox Name="HardwareSearch" Width="220" Watermark="Search alias or sensor key" />
            <ComboBox Name="HardwareTypeFilter" Width="160" SelectedIndex="0">
              <ComboBoxItem Content="All types" />
              <ComboBoxItem Content="Favorites" />
              <ComboBoxItem Content="Unavailable" />
              <ComboBoxItem Content="Temperature" />
              <ComboBoxItem Content="Load" />
              <ComboBoxItem Content="Fan" />
              <ComboBoxItem Content="Clock" />
              <ComboBoxItem Content="Voltage" />
              <ComboBoxItem Content="Power" />
              <ComboBoxItem Content="Data" />
              <ComboBoxItem Content="Throughput" />
              <ComboBoxItem Content="Other" />
            </ComboBox>
          </StackPanel>
          <CheckBox Name="HardwareFavoritesOnly" Content="Favorites only" />
                    <Grid ColumnDefinitions="34,2.1*,1.1*,1*,2.8*" Margin="8,0,8,4"><TextBlock Grid.Column="0" Text="★" /><TextBlock Grid.Column="1" Text="Sensor" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Value" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="Template key" FontWeight="SemiBold" /></Grid>
          <ListBox Name="HardwareSensorList" MinHeight="260" MaxHeight="450">
            <ListBox.DataTemplates>
              <DataTemplate DataType="local:HardwareSensorGroupHeader">
                <Border Background="#18222D" Padding="8,6" Margin="0,8,0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
              <DataTemplate DataType="local:HardwareSensorEntry">
                <Grid ColumnDefinitions="34,2.1*,1.1*,1*,2.8*" Margin="2,3">
                  <TextBlock Grid.Column="0" Text="{Binding Markers}" />
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SensorName}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding SensorType}" />
                  <TextBlock Grid.Column="3" Text="{Binding DisplayValue}" FontFamily="Consolas" />
                  <TextBlock Grid.Column="4" Text="{Binding Key}" FontFamily="Consolas" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <TextBlock Name="HardwareSelectedSensor" Text="Select a sensor above." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Name="HardwareAlias" Width="260" Watermark="Alias for selected sensor" />
            <CheckBox Name="HardwareFavorite" Content="Favorite" VerticalAlignment="Center" />
            <Button Name="HardwareSavePreference" Content="Save sensor preference" />
          </StackPanel>
          <TextBlock Name="HardwareSensorStatus" Text="Refresh to discover available sensors." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="HardwareUseForFan" Content="Use for Fan 1" IsEnabled="False" />
            <Button Name="HardwareUseForFan2" Content="Fan 2" IsEnabled="False" />
            <Button Name="HardwareUseForFan3" Content="Fan 3" IsEnabled="False" />
            <Button Name="HardwareUseForFan4" Content="Fan 4" IsEnabled="False" />
          </StackPanel>
          <TextBlock Text="Sensor assignment updates the fan editor but is not saved until you explicitly save fan configuration. Physical fan output remains disabled unless separately authorized." TextWrapping="Wrap" />
          <TextBlock Text="Display presets" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="Create editable display pages from available hardware sensor keys. Pages are saved to the portable workspace; no LIS2 device commands are sent." TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="HardwarePresetCPU" Content="CPU" />
            <Button Name="HardwarePresetGPU" Content="GPU" />
            <Button Name="HardwarePresetMemory" Content="Memory" />
            <Button Name="HardwarePresetTemperatures" Content="Temperatures" />
            <Button Name="HardwarePresetFans" Content="Fans" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="DiagnosticsView" Grid.Row="1" IsVisible="False">
        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto" Margin="0,0,8,8">
          <Border Grid.Row="0" Grid.Column="0" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Diagnostics Snapshot" FontSize="18" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="DiagnosticsExport" Content="Export report..." />
                <Button Name="DiagnosticsRefresh" Content="Refresh" />
              </StackPanel>
              <TextBox Name="DiagnosticsSnapshot" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="210" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Grid.Row="0" Grid.Column="2" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Virtual LIS2 state" FontSize="18" FontWeight="SemiBold" />
              <TextBox Name="DiagnosticsVirtualState" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="0" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Decoded command history" FontSize="18" FontWeight="SemiBold" />
              <TextBox Name="DiagnosticsCommandHistory" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Grid.Row="2" Grid.Column="2" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Protocol Log" FontSize="18" FontWeight="SemiBold" />
              <TextBox Name="DiagnosticsProtocolLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <ScrollViewer Name="SettingsView" Grid.Row="1" IsVisible="False"><StackPanel Spacing="14">
          <Border BorderBrush="#D4DCE5" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Name="SettingsDeviceHeading" Text="Device / Transport" FontWeight="SemiBold" FontSize="18"/>
              <Grid ColumnDefinitions="100,190,100,180,*" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Name="SettingsTransportLabel" Text="Transport" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" Name="TransportModeComboBox" SelectedIndex="0">
                  <ComboBoxItem Content="Virtual"/>
                  <ComboBoxItem Content="Serial"/>
                </ComboBox>
                <TextBlock Grid.Column="2" Name="SettingsPortLabel" Text="COM port" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="3" Name="SettingsPortComboBox"/>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7">
                  <Button Name="SettingsRefreshPorts" Content="Refresh"/>
                  <Button Name="SettingsApplyTransport" Content="Apply / reconnect"/>
                </StackPanel>
              </Grid>
              <TextBlock Name="SettingsTransportStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Name="SettingsAppearanceHeading" Text="Appearance" FontWeight="SemiBold" FontSize="18"/>
              <Grid ColumnDefinitions="100,220,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                <TextBlock Grid.Row="0" Name="SettingsThemeLabel" Text="Theme" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Name="ThemeModeComboBox">
                  <ComboBoxItem Content="System default"/>
                  <ComboBoxItem Content="Light"/>
                  <ComboBoxItem Content="Dark"/>
                </ComboBox>
                <TextBlock Grid.Row="0" Grid.Column="2" Name="SettingsThemeHint" Text="System default follows the operating system theme." VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.65"/>
                <TextBlock Grid.Row="1" Name="SettingsLanguageLabel" Text="Language" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="LanguageModeComboBox">
                  <ComboBoxItem Content="System default"/>
                  <ComboBoxItem Content="English"/>
                  <ComboBoxItem Content="German"/>
                  <ComboBoxItem Content="French"/>
                  <ComboBoxItem Content="Turkish"/>
                  <ComboBoxItem Content="Russian"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="2" Name="SettingsLanguageHint" Text="System default uses the operating system display language." VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.65"/>
              </Grid>
              <TextBlock Name="SettingsAppearanceStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <Border Name="SettingsWindowsCard" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Windows" FontWeight="SemiBold" FontSize="18"/>
              <CheckBox Name="StartWithWindowsCheckBox" Content="Start LIS2 Control Center with Windows (minimized to tray)"/>
              <TextBlock Name="SettingsStartupStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <StackPanel IsVisible="False" Spacing="10">
          <Separator Margin="0,10,0,2"/>
          <TextBlock Text="Advanced / Diagnostics" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Windows settings import" FontSize="18" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Name="ImportWindowsSettings" Content="Import Windows settings.json..." />
            <TextBlock Name="WindowsImportStatus" Text="Existing Windows settings remain unchanged." VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock Name="VirtualStatus" Text="Disconnected" TextWrapping="Wrap" Opacity="0.75"/>
          <Separator Margin="0,12,0,4"/>
          <TextBlock Text="Device / Transport" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Experimental serial and virtual transport diagnostics. No hardware fan authorization is implied." TextWrapping="Wrap"/>          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />


          <Separator Margin="0,12,0,4" />
          <TextBlock Text="Serial display" FontWeight="SemiBold" />
          <ComboBox Name="SerialPortPicker" MinWidth="180" />
          <Button Name="SerialRefreshPorts" Content="Refresh serial ports" HorizontalAlignment="Left" />
          <Button Name="SerialConnect" Content="Connect serial display" HorizontalAlignment="Left" />
          <Button Name="SerialDisconnect" Content="Disconnect serial" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendLines" Content="Send display lines" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStart" Content="Start serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStop" Content="Stop serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialPlaybackStatus" Text="Serial sequence stopped" TextWrapping="Wrap" />
          <Button Name="SerialSendPage" Content="Send selected page" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendGlyphs" Content="Program 8 glyphs" HorizontalAlignment="Left" IsEnabled="False" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Brightness" VerticalAlignment="Center" />
            <ComboBox Name="SerialBrightness" SelectedIndex="0" Width="75">
              <ComboBoxItem Content="100%" />
              <ComboBoxItem Content="75%" />
              <ComboBoxItem Content="50%" />
              <ComboBoxItem Content="25%" />
            </ComboBox>
            <Button Name="SerialApplyBrightness" Content="Apply" IsEnabled="False" />
          </StackPanel>
          <Button Name="SerialClear" Content="Clear serial display" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialStatus" Text="Serial display disconnected; fan control unavailable." TextWrapping="Wrap" />
          <Button Name="VirtualConnect" Content="Connect virtual LIS2" HorizontalAlignment="Left" />
          <Button Name="VirtualDisconnect" Content="Disconnect" IsEnabled="False" HorizontalAlignment="Left" />
      
          </StackPanel>
</StackPanel></ScrollViewer>
    </Grid>
  </Grid>
</Window>
