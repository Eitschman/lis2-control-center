<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LIS2.App.Avalonia.MainWindow"
        Title="LIS2 Control Center"
        Width="1320" Height="900" MinWidth="1120" MinHeight="760"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="250,*">
    <Border Grid.Column="0" Background="#182431" BorderBrush="#354351" BorderThickness="0,0,1,0">
      <Grid Margin="18" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="LIS2 CONTROL CENTER" FontSize="16" FontWeight="Bold" Margin="4,18,0,24" Foreground="White" />
        <StackPanel Grid.Row="1" Spacing="8">
          <ListBox Name="Navigation" SelectedIndex="0">
            <ListBoxItem Content="⌂    Dashboard" />
            <ListBoxItem Content="▣    Display" />
            <ListBoxItem Content="▤    Pages" />
            <ListBoxItem Content="♫    Media" />
            <ListBoxItem Content="⚠    Events" />
            <ListBoxItem Content="▦    Hardware" />
            <ListBoxItem Content="✽    Fan Control" />
            <ListBoxItem Content="⚙    Settings" />
            <ListBoxItem Content="∿    Diagnostics" />
            <ListBoxItem Content="⌂    Home Assistant" />
          </ListBox>
          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />
          <TextBlock Name="TransportSummaryText" Text="Virtual LIS2" TextWrapping="Wrap" Margin="4,0,0,0" />
          <TextBlock Name="VirtualStatus" Text="Disconnected" Margin="4,4,0,0" />
          <Separator Margin="0,12,0,4" />
          <TextBlock Text="Serial display (experimental)" FontWeight="SemiBold" />
          <ComboBox Name="SerialPortPicker" MinWidth="180" />
          <Button Name="SerialRefreshPorts" Content="Refresh serial ports" HorizontalAlignment="Left" />
          <Button Name="SerialConnect" Content="Connect serial display" HorizontalAlignment="Left" />
          <Button Name="SerialDisconnect" Content="Disconnect serial" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendLines" Content="Send display lines" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStart" Content="Start serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStop" Content="Stop serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialPlaybackStatus" Text="Serial sequence stopped" TextWrapping="Wrap" />
          <Button Name="SerialSendPage" Content="Send selected page" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendGlyphs" Content="Program 8 glyphs" HorizontalAlignment="Left" IsEnabled="False" />
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Brightness" VerticalAlignment="Center" />
            <ComboBox Name="SerialBrightness" SelectedIndex="0" Width="75">
              <ComboBoxItem Content="100%" />
              <ComboBoxItem Content="75%" />
              <ComboBoxItem Content="50%" />
              <ComboBoxItem Content="25%" />
            </ComboBox>
            <Button Name="SerialApplyBrightness" Content="Apply" IsEnabled="False" />
          </StackPanel>
          <Button Name="SerialClear" Content="Clear serial display" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialStatus" Text="Serial display disconnected; fan control unavailable." TextWrapping="Wrap" />
          <Button Name="VirtualConnect" Content="Connect virtual LIS2" HorizontalAlignment="Left" />
          <Button Name="VirtualDisconnect" Content="Disconnect" IsEnabled="False" HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="4,12,0,10" Spacing="7">
          <Separator />
          <TextBlock Text="ⓘ  LIS2 Control Center" />
          <TextBlock Text="◉  GitHub" Opacity="0.65" />
          <TextBlock Text="ⓘ  About" Opacity="0.65" />
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20" RowDefinitions="Auto,*">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
        <StackPanel Grid.Column="0" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Name="SectionTitle" Text="Dashboard" FontSize="30" FontWeight="SemiBold" />
            <Button Content="?" Width="32" Height="32" ToolTip.Tip="Help for this page" />
          </StackPanel>
          <TextBlock Name="SectionDescription" Text="Overview and quick access to the most important functions." Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Background="#354351" CornerRadius="14" Padding="14,9" VerticalAlignment="Top">
          <TextBlock Name="ConnectionText" Text="Disconnected" FontWeight="SemiBold" />
        </Border>
      </Grid>
      <ScrollViewer Name="DashboardView" Grid.Row="1">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="3*,14,2*">
            <Border Grid.Column="0" BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" />
                <Border Background="#07190E" BorderBrush="#33523D" BorderThickness="1" CornerRadius="6" Padding="24,20">
                  <StackPanel>
                    <TextBlock Name="PreviewLine1" Text="                    " FontFamily="Consolas" FontSize="31" Foreground="#70EF86" />
                    <TextBlock Name="PreviewLine2" Text="                    " FontFamily="Consolas" FontSize="31" Foreground="#70EF86" />
                  </StackPanel>
                </Border>
                <Button Name="VirtualDemo" Content="Send demo display" IsEnabled="False" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Spacing="14">
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="System Status" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Name="VirtualStateText" Text="State available when Virtual transport is active." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Quick Links" FontSize="16" FontWeight="SemiBold" />
                  <Button Name="OpenDisplayControls" Content="Open Display Controls" />
                  <Button Name="OpenFanControl" Content="Open Fan Control" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,12,Auto,14,Auto">
                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 1" VerticalAlignment="Center" />
                <Slider Name="DashboardFan1Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan1Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 2" VerticalAlignment="Center" />
                <Slider Name="DashboardFan2Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan2Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 3" VerticalAlignment="Center" />
                <Slider Name="DashboardFan3Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan3Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 4" VerticalAlignment="Center" />
                <Slider Name="DashboardFan4Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan4Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Name="DashboardFansApply" Content="Apply" HorizontalAlignment="Right" MinWidth="110" IsEnabled="False" />
              </Grid>
              <TextBlock Text="Fan outputs are read-only until the safety-reviewed fan runtime is ported." Opacity="0.65" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="6" Padding="12,9">
            <TextBlock Text="💡  Tip: Use the navigation on the left to access display settings, page editor, Winamp integration, hardware and fan control." TextWrapping="Wrap" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    <ScrollViewer Name="DisplayView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Quick Display Test" FontWeight="SemiBold" FontSize="16" />
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Line 1" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,9" />
              <Button Name="SendLine1" Grid.Row="0" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <TextBlock Grid.Row="1" Text="Line 2" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,9" />
              <Button Name="SendLine2" Grid.Row="1" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="7">
                <Button Name="RenderBoth" Content="Render both lines" />
                <Button Name="ClearDisplay" Content="Clear" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Character ROM / Special Characters" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="Native LIS2 characters use the uPD16314 ROM. Test the mapped Unicode set or inspect raw ROM bytes on the real display." TextWrapping="Wrap" Opacity="0.7" />
            <WrapPanel>
              <Button Name="SendSpecialCharacterTest" Content="Send special-character test" Margin="0,0,8,0" />
              <TextBlock Text="Ä Ö Ü  ä ö ü  ß  °  µ  ±  £  ×  ÷  ← →  Ω π Σ √ ∞" FontFamily="Consolas" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="ROM start byte" VerticalAlignment="Center" />
              <TextBox Name="CharacterRomStartTextBox" Text="80" Width="90" MaxLength="2" />
              <Button Name="CharacterRomPrevious" Content="Previous" />
              <Button Name="SendCharacterRomRange" Content="Send 40 bytes" />
              <Button Name="CharacterRomNext" Content="Next" />
              <TextBlock Name="CharacterRomRangeText" Text="80-A7" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Custom Characters / CG Builder" FontWeight="SemiBold" FontSize="16" />
            <CheckBox Name="ProgramGlyphsOnConnect" Content="Program saved glyphs on connect" />
            <Grid ColumnDefinitions="190,220,24,*">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Slot" />
                <ComboBox Name="GlyphSlot" SelectedIndex="0"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" /></ComboBox>
                <TextBlock Text="Name" />
                <TextBox Name="GlyphName" Text="Glyph 1" />
                <TextBlock Text="Template key" />
                <TextBlock Name="GlyphTemplateKey" Text="{}{Glyph.1}" FontFamily="Consolas" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="5x8 bitmap (8 rows)" />
                <TextBox Name="GlyphBitmapEditor" AcceptsReturn="True" Height="150" Text="00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000" />
              </StackPanel>
              <Border Grid.Column="3" Background="#07190E" CornerRadius="5" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Name="GlyphPixelPreview" Text="·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····&#10;·····" FontFamily="Consolas" FontSize="22" Foreground="#70EF86" />
                  <TextBlock Text="20x2 template preview" />
                </StackPanel>
              </Border>
            </Grid>
            <WrapPanel>
              <Button Name="SaveGlyph" Content="Save glyph" />
              <Button Name="SendGlyphSlot" Content="Send slot to LIS2" />
              <Button Name="SendAllGlyphs" Content="Send all 8 slots" />
              <Button Name="LoadGlyphSet" Content="Load set..." />
              <Button Name="SaveGlyphSet" Content="Save set..." />
              <Button Name="LoadExampleGlyphs" Content="Load examples" />
            </WrapPanel>
            <TextBlock Text="{}Use {Glyph.Name} or {Glyph.1} through {Glyph.8} in page templates." Opacity="0.7" />
          </StackPanel>
        </Border>
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="16" />
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Name="Brightness100" Content="100%" />
              <Button Name="Brightness75" Content="75%" />
              <Button Name="Brightness50" Content="50%" />
              <Button Name="Brightness25" Content="25%" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="PagesView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border BorderBrush="#596675" BorderThickness="1" CornerRadius="7" Padding="16">
          <Grid ColumnDefinitions="230,16,*">
            <StackPanel Grid.Column="0" Spacing="9">
              <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16" />
              <ListBox Name="PagesList" Height="380" />
              <WrapPanel>
                <Button Name="PageAdd" Content="Add" Margin="0,0,7,7" />
                <Button Name="PageDuplicate" Content="Duplicate" Margin="0,0,7,7" />
                <Button Name="PageDelete" Content="Delete" />
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageImport" Content="Load pages..." />
                <Button Name="PageExport" Content="Save pages..." />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageUp" Content="↑  Move up" />
                <Button Name="PageDown" Content="↓  Move down" />
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="9">
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Row="0" Text="Name" />
                <TextBox Name="PageName" Grid.Row="0" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="Line 1" />
                <TextBox Name="PageLine1" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" Text="Line 2" />
                <TextBox Name="PageLine2" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" Text="Duration (s)" />
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBox Name="PageDuration" Width="90" />
                  <TextBlock Text="Refresh (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageRefresh" Width="90" />
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Visible when" />
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBox Name="PageConditionKey" Width="185" Watermark="Template key" />
                    <ComboBox Name="PageConditionOperator" Width="85">
                      <ComboBoxItem Content="=" /><ComboBoxItem Content="!=" />
                      <ComboBoxItem Content="&gt;" /><ComboBoxItem Content="&gt;=" />
                      <ComboBoxItem Content="&lt;" /><ComboBoxItem Content="&lt;=" />
                    </ComboBox>
                    <TextBox Name="PageConditionValue" Width="110" Watermark="Value" />
                    <Button Name="PageApplyCondition" Content="Apply condition" />
                  </StackPanel>
                  <TextBox Name="PageVisibility" Watermark="Raw visibility expression" />
                  <TextBlock Name="PageConditionStatus" Opacity="0.65" />
                </StackPanel>
                <TextBlock Grid.Row="5" Text="Overflow" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <ComboBox Name="PageOverflow1" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                  <ComboBox Name="PageOverflow2" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                </StackPanel>
                <TextBlock Grid.Row="6" Text="Scroll timing" />
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Step (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageScrollStep" Width="75" />
                  <TextBlock Text="Edge pause (ms)" VerticalAlignment="Center" />
                  <TextBox Name="PageScrollPause" Width="75" />
                </StackPanel>
                <TextBlock Grid.Row="7" Text="Enabled" />
                <CheckBox Name="PageEnabled" Grid.Row="7" Grid.Column="1" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="ImportWindowsSettings" Content="Import Windows settings.json..." />
                <TextBlock Name="WindowsImportStatus" Text="Existing Windows settings remain unchanged." VerticalAlignment="Center" Opacity="0.7" />
              </StackPanel>
              <TextBlock Text="Home Assistant (read-only WebSocket source)" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="HaUrl" Width="310" Watermark="http://homeassistant.local:8123" />
                <TextBox Name="HaToken" Width="240" PasswordChar="*" Watermark="Long-lived access token" />
                <Button Name="HaConnect" Content="Connect HA" />
                <Button Name="HaDisconnect" Content="Disconnect HA" />
                <Button Name="HaTest" Content="Test" />
              </StackPanel>
              <TextBlock Name="HaStatus" Text="Home Assistant not configured" Opacity="0.75" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="HaEntityFilter" Width="240" Watermark="Filter entities" />
                <ComboBox Name="HaEntityPicker" Width="370" />
                <Button Name="HaInsertLine1" Content="Insert state into line 1" />
                <Button Name="HaInsertLine2" Content="Insert state into line 2" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <ComboBox Name="PageVariablePicker" Width="220" />
                <Button Name="PageInsertLine1" Content="Insert into line 1" />
                <Button Name="PageInsertLine2" Content="Insert into line 2" />
                <Button Name="PageRefreshVariables" Content="Refresh variables" />
              </StackPanel>
              <TextBlock Name="PageVariableStatus" Opacity="0.65" />
              <TextBlock Name="PagePlaybackStatus" Text="Sequence stopped" Opacity="0.75" />
              <TextBlock Text="Live preview" FontWeight="SemiBold" />
              <Border Background="#07190E" BorderBrush="#33523D" BorderThickness="1" CornerRadius="6" Padding="18,12" HorizontalAlignment="Left">
                <StackPanel>
                  <TextBlock Name="PagePreview1" FontFamily="Consolas" FontSize="26" Foreground="#70EF86" />
                  <TextBlock Name="PagePreview2" FontFamily="Consolas" FontSize="26" Foreground="#70EF86" />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Button Name="PageSave" Content="Save page" />
                <Button Name="PageTest" Content="Send page to virtual LIS2" />
                <Button Name="PagePlaybackStart" Content="Start sequence" />
                <Button Name="PagePlaybackStop" Content="Stop sequence" IsEnabled="False" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    </Grid>
  </Grid>
</Window>
