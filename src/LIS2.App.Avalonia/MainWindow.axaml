<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LIS2.App.Avalonia"
        x:Class="LIS2.App.Avalonia.MainWindow"
        Title="LIS2 Control Center"
        Width="1305" Height="893" MinWidth="950" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Lis2SurfaceBrush}">
  <Window.Resources>
    <x:String x:Key="PageFormattingHint">Formatting: {Key|number:2}&#10;50.1234567 → 50,12 (German regional settings)&#10;fallback, fallbackvar, percent, bytes, prefix, suffix, upper, lower&#10;More examples: Pages help</x:String>
  </Window.Resources>
  <Window.Styles>
    <Style Selector="Border.vfdDisplay">
      <Setter Property="Background" Value="#123B8A" />
      <Setter Property="BorderBrush" Value="#5D8FE8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,12" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="local|VfdLine.vfdLine">
      <Setter Property="FontFamily" Value="Consolas,DejaVu Sans Mono,Liberation Mono" />
      <Setter Property="FontSize" Value="24" />
      <Setter Property="Foreground" Value="#F7FBFF" />
    </Style>
  </Window.Styles>
  <Grid ColumnDefinitions="250,*">
    <Border Grid.Column="0" Background="{DynamicResource Lis2SidebarBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Text="LIS2 CONTROL CENTER" FontSize="16" FontWeight="Bold" Margin="4,18,0,24" Foreground="{DynamicResource Lis2SidebarTextBrush}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="8">
          <StackPanel Name="NavigationPanel" Spacing="2">
            <Button Name="NavButton0" Tag="0" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M2,8 L8,2 L14,8 M4,7 L4,14 L12,14 L12,7"/><TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton1" Tag="1" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M2,3 L14,3 L14,13 L2,13 Z M5,6 L11,6 M5,9 L11,9"/><TextBlock Grid.Column="1" Text="Display" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton2" Tag="2" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M3,2 L13,2 L13,14 L3,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11"/><TextBlock Grid.Column="1" Text="Pages" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton3" Tag="3" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M5,12 L5,3 L13,2 L13,10 M5,5 L13,4"/><TextBlock Grid.Column="1" Text="Media" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton4" Tag="4" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M8,2 L15,14 L1,14 Z M8,6 L8,10 M8,12 L8,12.5"/><TextBlock Grid.Column="1" Text="Events" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton5" Tag="5" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M2,3 L14,3 L14,13 L2,13 Z M6,3 L6,13 M10,3 L10,13"/><TextBlock Grid.Column="1" Text="Hardware" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton6" Tag="6" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M8,2 L8,14 M2,8 L14,8 M4,4 L12,12 M12,4 L4,12"/><TextBlock Grid.Column="1" Text="Fan Control" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton7" Tag="7" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M6,2 L10,2 L11,4 L13,5 L14,8 L13,11 L11,12 L10,14 L6,14 L5,12 L3,11 L2,8 L3,5 L5,4 Z M8,6 L8,10"/><TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton8" Tag="8" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M2,10 Q5,3 8,8 T14,6 M2,13 L14,13"/><TextBlock Grid.Column="1" Text="Diagnostics" VerticalAlignment="Center"/></Grid></Button>
            <Button Name="NavButton9" Tag="9" HorizontalContentAlignment="Stretch" Padding="9,10" Background="Transparent" BorderThickness="0" CornerRadius="5"><Grid ColumnDefinitions="28,*"><Path Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Lis2IconBrush}" StrokeThickness="1.5" Data="M2,8 L8,2 L14,8 M4,7 L4,14 L12,14 L12,7 M6,10 L10,10"/><TextBlock Grid.Column="1" Text="Home Assistant" VerticalAlignment="Center"/></Grid></Button>
          </StackPanel>
          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />
          <TextBlock Name="TransportSummaryText" Text="Virtual LIS2" TextWrapping="Wrap" Margin="4,0,0,4" />
          <Button Name="OpenTransportSettings" Content="Change..." HorizontalAlignment="Left" MinWidth="110" />
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Margin="4,12,0,10" Spacing="7">
          <Separator />
          <Button Name="OpenAbout" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch" Padding="10,7">
            <TextBlock Text="About LIS2 Control Center" TextWrapping="Wrap" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="20" RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,18">
        <TextBlock Grid.Column="0" Name="SectionTitle" Text="Dashboard" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Grid.Column="1" Name="OpenHelp" Content="Help &amp; reference" Margin="12,0" VerticalAlignment="Top" />
        <Border Grid.Column="2" Background="{DynamicResource Lis2StatusBrush}" CornerRadius="14" Padding="14,9" VerticalAlignment="Top">
          <TextBlock Name="ConnectionText" Text="Disconnected" FontWeight="SemiBold" Foreground="{DynamicResource Lis2StatusTextBrush}" />
        </Border>
      </Grid>
      <ScrollViewer Name="DashboardView" Grid.Row="1">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,14,*">
            <Border Background="{DynamicResource Lis2CardBrush}" Grid.Column="0" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Text="VFD Preview" FontWeight="SemiBold" FontSize="16" />
                <Border Classes="vfdDisplay">
                  <StackPanel HorizontalAlignment="Left" Spacing="0">
                    <local:VfdLine Name="PreviewLine1" Classes="vfdLine" Text="                    " />
                    <local:VfdLine Name="PreviewLine2" Classes="vfdLine" Text="                    " />
                  </StackPanel>
                </Border>
                <Button Name="VirtualDemo" Content="Send demo display" IsEnabled="False" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Spacing="14">
              <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="System Status" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Name="VirtualStateText" Text="State available when Virtual transport is active." TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                <StackPanel Spacing="10">
                  <TextBlock Text="Quick Links" FontSize="16" FontWeight="SemiBold" />
                  <WrapPanel>
                    <Button Name="OpenDisplayControls" Content="Open Display Controls" Margin="0,0,8,8" />
                    <Button Name="OpenFanControl" Content="Open Fan Control" Margin="0,0,8,8" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Fan Outputs" FontWeight="SemiBold" FontSize="16" />
              <Grid ColumnDefinitions="*,18,*" RowDefinitions="Auto,12,Auto,14,Auto">
                <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 1" VerticalAlignment="Center" />
                <Slider Name="DashboardFan1Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan1Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 2" VerticalAlignment="Center" />
                <Slider Name="DashboardFan2Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan2Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="0" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 3" VerticalAlignment="Center" />
                <Slider Name="DashboardFan3Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan3Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="70,*,55">
                <TextBlock Grid.Column="0" Text="Fan 4" VerticalAlignment="Center" />
                <Slider Name="DashboardFan4Slider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True" Margin="6,0,10,0" IsEnabled="False" />
                <TextBlock Name="DashboardFan4Value" Grid.Column="2" Text="100 %" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" />
              </Grid>
                <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Right">
                  <CheckBox Name="DashboardFanConsent" Content="Authorize serial fan output" IsVisible="False" Margin="0,0,12,0"/>
                  <Button Name="DashboardFansApply" Content="Apply" MinWidth="110" IsEnabled="False"/>
                </WrapPanel>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    <ScrollViewer Name="DisplayView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Display controls" FontWeight="SemiBold" FontSize="18" />
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Line 1" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line1TextBox" Grid.Row="0" Grid.Column="1" Text="LIS2 Control Center" Margin="0,0,10,9" />
              <Button Name="SendLine1" Grid.Row="0" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <TextBlock Grid.Row="1" Text="Line 2" VerticalAlignment="Center" Margin="0,0,10,9" />
              <TextBox Name="Line2TextBox" Grid.Row="1" Grid.Column="1" Text="Virtual device" Margin="0,0,10,9" />
              <Button Name="SendLine2" Grid.Row="1" Grid.Column="2" Content="Send" Margin="0,0,0,9" />
              <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="7">
                <Button Name="RenderBoth" Content="Render both lines" />
                <Button Name="ClearDisplay" Content="Clear" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Character ROM / Special Characters" FontWeight="SemiBold" FontSize="18" />
            <WrapPanel>
              <Button Name="SendSpecialCharacterTest" Content="Send special-character test" Margin="0,0,8,0" />
              <TextBlock Text="Ä Ö Ü  ä ö ü  ß  °  µ  ±  £  ×  ÷  ← →  Ω π Σ √ ∞" FontFamily="Consolas" />
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Text="ROM start byte" VerticalAlignment="Center" />
              <TextBox Name="CharacterRomStartTextBox" Text="80" Width="90" MaxLength="2" />
              <Button Name="CharacterRomPrevious" Content="Previous" />
              <Button Name="SendCharacterRomRange" Content="Send 40 bytes" />
              <Button Name="CharacterRomNext" Content="Next" />
              <TextBlock Name="CharacterRomRangeText" Text="80-A7" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Custom Characters / CG Builder" FontWeight="SemiBold" FontSize="18" />
            <CheckBox Name="ProgramGlyphsOnConnect" Content="Program saved glyphs on connect" />
            <Grid ColumnDefinitions="200,250,20,*">
              <StackPanel Grid.Column="0" Spacing="5">
                <TextBlock Text="Slot" />
                <ComboBox Name="GlyphSlot" SelectedIndex="0"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" /></ComboBox>
                <TextBlock Text="Name" />
                <TextBox Name="GlyphName" Text="Glyph 1" />
                <TextBlock Text="Template key" />
                <TextBlock Name="GlyphTemplateKey" Text="{}{Glyph.1}" FontFamily="Consolas" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="5x8 bitmap (8 rows)" />
                <TextBox Name="GlyphBitmapEditor" AcceptsReturn="True" Height="150" Text="00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000&#10;00000" />
              </StackPanel>
              <Border Grid.Column="3" Background="#07190E" CornerRadius="5" Padding="16">
                <StackPanel Spacing="10">
                  <UniformGrid Name="GlyphPixelGrid" Rows="8" Columns="5" HorizontalAlignment="Left" />
                  <TextBlock Name="GlyphPixelStatus" TextWrapping="Wrap" Foreground="#F7FBFF" />
                </StackPanel>
              </Border>
            </Grid>
            <WrapPanel>
              <Button Name="SaveGlyph" Content="Save glyph" />
              <Button Name="SendGlyphSlot" Content="Send slot to LIS2" />
              <Button Name="SendAllGlyphs" Content="Send all 8 slots" />
              <Button Name="LoadGlyphSet" Content="Load set..." />
              <Button Name="SaveGlyphSet" Content="Save set..." />
              <Button Name="LoadExampleGlyphs" Content="Load examples" />
            </WrapPanel>
            <TextBlock Name="GlyphSaveStatus" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Brightness" FontWeight="SemiBold" FontSize="18" />
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Button Name="Brightness100" Content="100%" />
              <Button Name="Brightness75" Content="75%" />
              <Button Name="Brightness50" Content="50%" />
              <Button Name="Brightness25" Content="25%" />
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="PagesView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <Grid Name="PageEditorLayout" ColumnDefinitions="250,18,*">
            <StackPanel Grid.Column="0" Spacing="9">
              <TextBlock Text="Pages" FontWeight="SemiBold" FontSize="16" />
              <TextBlock Text="Preset" Opacity="0.7"/>
              <ComboBox Name="PagePresetPicker" SelectedIndex="0">
                <ComboBoxItem Content="General · Clock &amp; date"/>
                <ComboBoxItem Content="General · LIS2 status"/>
                <ComboBoxItem Content="Hardware · CPU"/>
                <ComboBoxItem Content="Hardware · GPU"/>
                <ComboBoxItem Content="Hardware · Memory"/>
                <ComboBoxItem Content="Hardware · Temperatures"/>
                <ComboBoxItem Content="Hardware · Fans"/>
                <ComboBoxItem Content="Winamp · Now Playing"/>
                <ComboBoxItem Content="Winamp · VU"/>
                <ComboBoxItem Content="Winamp · Spectrum"/>
                <ComboBoxItem Content="Media · Windows Media Now Playing"/>
                <ComboBoxItem Content="Linux MPRIS players (playerctl)"/>
                <ComboBoxItem Content="WMP Legacy Now Playing"/>
                <ComboBoxItem Content="WMP Legacy VU"/>
                <ComboBoxItem Content="WMP Legacy Spectrum"/>
              </ComboBox>
              <Button Name="PageCreatePreset" Content="Create from preset" HorizontalAlignment="Stretch"/>
              <ListBox Name="PagesList" MinHeight="250" MaxHeight="420">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" Margin="3,4">
                      <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=OneWay}" Click="PageListEnabledClick"
                                VerticalAlignment="Center" ToolTip.Tip="Enable or disable this page"/>
                      <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel>
                <Button Name="PageAdd" Content="Add" Margin="0,0,7,7" />
                <Button Name="PageDuplicate" Content="Duplicate" Margin="0,0,7,7" />
                <Button Name="PageDelete" Content="Delete" />
              </WrapPanel>
              <WrapPanel>
                <Button Margin="0,0,7,7" Name="PageImport" Content="Load pages..." />
                <Button Margin="0,0,7,7" Name="PageExport" Content="Save pages..." />
              </WrapPanel>
              <WrapPanel>
                <Button Margin="0,0,7,7" Name="PageUp" Content="↑  Move up" />
                <Button Margin="0,0,7,7" Name="PageDown" Content="↓  Move down" />
              </WrapPanel>
            </StackPanel>
            <StackPanel Name="PagePropertiesPane" Grid.Column="2" Spacing="9">
              <TextBlock Text="Page properties" FontSize="16" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="9" ColumnSpacing="10">
                <TextBlock Grid.Row="0" Text="Name" />
                <TextBox Name="PageName" Grid.Row="0" Grid.Column="1" />
                <TextBlock Grid.Row="1" Text="Line 1" />
                <TextBox Name="PageLine1" Grid.Row="1" Grid.Column="1" ToolTip.Tip="{StaticResource PageFormattingHint}" ToolTip.Placement="Bottom" />
                <TextBlock Grid.Row="2" Text="Line 2" />
                <TextBox Name="PageLine2" Grid.Row="2" Grid.Column="1" ToolTip.Tip="{StaticResource PageFormattingHint}" ToolTip.Placement="Bottom" />
                <TextBlock Grid.Row="3" Text="Duration (s)" />
                <WrapPanel Grid.Row="3" Grid.Column="1">
                  <TextBox Margin="0,0,8,8" Name="PageDuration" Width="90" />
                  <TextBlock Margin="0,0,8,8" Text="Refresh (ms)" VerticalAlignment="Center" />
                  <TextBox Margin="0,0,8,8" Name="PageRefresh" Width="90" />
                </WrapPanel>
                <TextBlock Grid.Row="4" Text="Visible when" TextWrapping="Wrap" />
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="5">
                  <WrapPanel>
                    <TextBox Margin="0,0,7,7" Name="PageConditionKey" Width="185" Watermark="Template key" />
                    <Button Margin="0,0,7,7" Name="PageConditionBrowse" Content="Browse variables…" />
                    <ComboBox Margin="0,0,7,7" Name="PageConditionOperator" Width="85">
                      <ComboBoxItem Content="=" /><ComboBoxItem Content="!=" />
                      <ComboBoxItem Content="&gt;" /><ComboBoxItem Content="&gt;=" />
                      <ComboBoxItem Content="&lt;" /><ComboBoxItem Content="&lt;=" />
                    </ComboBox>
                    <TextBox Margin="0,0,7,7" Name="PageConditionValue" Width="110" Watermark="Value" />
                    <Button Margin="0,0,7,7" Name="PageApplyCondition" Content="Apply condition" />
                  </WrapPanel>
                  <TextBox Name="PageVisibility" Watermark="Raw visibility expression" />
                  <TextBlock Name="PageConditionStatus" Opacity="0.65" />
                </StackPanel>
                <TextBlock Grid.Row="5" Text="Overflow" />
                <WrapPanel Grid.Row="5" Grid.Column="1">
                  <ComboBox Margin="0,0,8,8" Name="PageOverflow1" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                  <ComboBox Margin="0,0,8,8" Name="PageOverflow2" Width="135"><ComboBoxItem Content="PingPong" /><ComboBoxItem Content="Truncate" /><ComboBoxItem Content="Marquee" /></ComboBox>
                </WrapPanel>
                <TextBlock Grid.Row="6" Text="Scroll timing" />
                <WrapPanel Grid.Row="6" Grid.Column="1">
                  <TextBlock Margin="0,0,8,8" Text="Step (ms)" VerticalAlignment="Center" />
                  <TextBox Margin="0,0,8,8" Name="PageScrollStep" Width="75" />
                  <TextBlock Margin="0,0,8,8" Text="Edge pause (ms)" VerticalAlignment="Center" />
                  <TextBox Margin="0,0,8,8" Name="PageScrollPause" Width="75" />
                </WrapPanel>
                <TextBlock Grid.Row="7" Text="Enabled" />
                <CheckBox Name="PageEnabled" Grid.Row="7" Grid.Column="1" />
              </Grid>
              <TextBlock Text="Insert template variable" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <WrapPanel>
                <Button Margin="0,0,8,8" Name="PageVariableBrowser" Content="Browse variables…" MinWidth="180" />
              </WrapPanel>
              <TextBlock Name="PageVariableStatus" Opacity="0.65" />
              <Expander Name="PageFormattingEditor" Header="Formatting editor" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{DynamicResource Lis2CardBrush}">
                <StackPanel Spacing="8" Margin="0,8,0,0">
                  <TextBlock Text="Variable" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="FormatVariable" />
                    <Button Grid.Column="1" Name="FormatBrowse" Content="Browse variables…" />
                  </Grid>
                  <WrapPanel>
                    <StackPanel Margin="0,0,12,8" Spacing="4">
                      <TextBlock Text="Number format" />
                      <ComboBox Name="FormatKind" SelectedIndex="0" MinWidth="160">
                        <ComboBoxItem Content="Unchanged"/><ComboBoxItem Content="Number"/>
                        <ComboBoxItem Content="Percent"/><ComboBoxItem Content="Bytes"/>
                      </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,8" Spacing="4">
                      <TextBlock Text="Decimal places" />
                      <NumericUpDown Name="FormatDecimals" Minimum="0" Maximum="6" Value="2" Increment="1" FormatString="0" Width="100" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" Spacing="4">
                      <TextBlock Text="Letter case" />
                      <ComboBox Name="FormatCase" SelectedIndex="0" MinWidth="150">
                        <ComboBoxItem Content="Unchanged"/><ComboBoxItem Content="Uppercase"/><ComboBoxItem Content="Lowercase"/>
                      </ComboBox>
                    </StackPanel>
                  </WrapPanel>
                  <TextBlock Text="Fallback variable" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Name="FormatFallbackVariable" />
                    <Button Grid.Column="1" Name="FormatFallbackBrowse" Content="Browse variables…" />
                  </Grid>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Text="Prefix" VerticalAlignment="Center"/><TextBox Name="FormatPrefix" Grid.Column="1" />
                    <TextBlock Grid.Row="1" Text="Suffix" VerticalAlignment="Center"/><TextBox Name="FormatSuffix" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="Missing value" VerticalAlignment="Center"/><TextBox Name="FormatFallback" Grid.Row="2" Grid.Column="1" />
                  </Grid>
                  <TextBlock Text="Template" FontWeight="SemiBold" />
                  <TextBox Name="FormatTemplate" IsReadOnly="True" TextWrapping="Wrap" />
                  <TextBlock Text="Current result" FontWeight="SemiBold" />
                  <TextBlock Name="FormatResult" TextWrapping="Wrap" />
                  <TextBlock Name="FormatStatus" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Name="FormatInsert1" Content="Insert into line 1" Margin="0,0,8,8"/>
                    <Button Name="FormatInsert2" Content="Insert into line 2" Margin="0,0,8,8"/>
                  </WrapPanel>
                </StackPanel>
              </Expander>
              <TextBlock Name="PageSaveStatus" TextWrapping="Wrap" />
              <Separator Margin="0,5"/>
              <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                <TextBlock Text="Live VFD preview" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Grid.Column="1" Name="PagePlaybackStatus" Text="Sequence stopped" Opacity="0.75" VerticalAlignment="Center"/>
              </Grid>
              <Border Classes="vfdDisplay">
                <StackPanel Spacing="0">
                  <local:VfdLine Name="PagePreview1" Classes="vfdLine" Text="                    "/>
                  <local:VfdLine Name="PagePreview2" Classes="vfdLine" Text="                    "/>
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button Margin="0,0,7,7" Name="PageSave" Content="Save page" />
                <Button Margin="0,0,7,7" Name="PageTest" Content="Test event (5 s)" />
                <Button Margin="0,0,7,7" Name="PagePlaybackStart" Content="Start sequence" />
                <Button Margin="0,0,7,7" Name="PagePlaybackStop" Content="Stop sequence" IsEnabled="False" />
              </WrapPanel>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="MediaView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="14">
        <Border Background="{DynamicResource Lis2CardBrush}" Name="WindowsMediaCard" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="Windows Media Player" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="{DynamicResource Lis2StatusBrush}" CornerRadius="12" Padding="12,7">
                <TextBlock Name="WindowsMediaStatus" Text="Disconnected" Foreground="{DynamicResource Lis2StatusTextBrush}" FontWeight="SemiBold"/>
              </Border>
            </Grid>
            <TextBlock Name="WindowsMediaTitle" Text="Nothing playing" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="WindowsMediaArtist" TextTrimming="CharacterEllipsis" FontSize="16"/>
            <TextBlock Name="WindowsMediaAlbum" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
            <TextBlock Name="WindowsMediaPlayback" FontWeight="SemiBold"/>
            <TextBlock Name="WindowsMediaSource" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
              <TextBlock Name="WindowsMediaTime" FontFamily="Consolas" FontSize="16" Opacity="0.7" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Name="WindowsMediaPage" Content="Create playback page"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" Name="LinuxMediaCard" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <TextBlock Text="Linux MPRIS players (playerctl)" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Text="Player"/>
            <ComboBox Name="LinuxMediaPlayer" HorizontalAlignment="Stretch"/>
            <TextBlock Name="LinuxMediaStatus" Text="Disconnected" TextWrapping="Wrap"/>
            <TextBlock Name="LinuxMediaTitle" Text="Nothing playing" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="LinuxMediaArtist" FontSize="16" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="LinuxMediaAlbum" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="LinuxMediaPlayback"/>
            <TextBlock Name="LinuxMediaDuration"/>
            <Button Name="LinuxMediaPage" Content="Create playback page"/>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" Name="WinampMediaCard" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="Winamp" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="{DynamicResource Lis2StatusBrush}" CornerRadius="12" Padding="12,7">
                <TextBlock Name="WinampMediaStatus" Text="Disconnected" Foreground="{DynamicResource Lis2StatusTextBrush}" FontWeight="SemiBold"/>
              </Border>
            </Grid>
            <TextBlock Name="WinampMediaTitle" Text="Nothing playing" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="WinampMediaArtist" Text="Waiting for Winamp..." FontSize="16" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="WinampMediaAlbum" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Grid ColumnDefinitions="*,16,*,16,*" Margin="0,6,0,10">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Playback" FontWeight="SemiBold"/>
                <TextBlock Name="WinampMediaPlayback" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="WinampMediaTime" FontFamily="Consolas" Opacity="0.7"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Text="Playlist" FontWeight="SemiBold"/>
                <TextBlock Name="WinampMediaPlaylist" Text="- / -" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="3">
                <TextBlock Text="Audio" FontWeight="SemiBold"/>
                <TextBlock Name="WinampMediaAudio" Text="-" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip.Tip="Bitrate / sample rate"/>
              </StackPanel>
            </Grid>
            <Separator/>
            <TextBlock Text="VU / Spectrum" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="25,*,45" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBlock Text="L" VerticalAlignment="Center"/>
              <ProgressBar Name="WinampVuLeft" Grid.Column="1" Maximum="255" Height="14"/>
              <TextBlock Name="WinampVuLeftValue" Grid.Column="2"/>
              <TextBlock Text="R" Grid.Row="1" VerticalAlignment="Center"/>
              <ProgressBar Name="WinampVuRight" Grid.Row="1" Grid.Column="1" Maximum="255" Height="14"/>
              <TextBlock Name="WinampVuRightValue" Grid.Row="1" Grid.Column="2"/>
            </Grid>
            <Grid Name="WinampSpectrumBars" Height="70" ColumnSpacing="3"/>
            <TextBlock Name="WinampMediaTelemetry" FontFamily="Consolas" TextWrapping="Wrap"/>
            <TextBlock Name="WinampMediaConnection" TextWrapping="Wrap"/>
            <Button Name="WinampMediaPage" Content="Create playback page" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" Name="WmpLegacyMediaCard" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="7">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
              <TextBlock Text="Windows Media Player Legacy" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
              <Border Grid.Column="1" Background="{DynamicResource Lis2StatusBrush}" CornerRadius="12" Padding="12,7">
                <TextBlock Name="WmpLegacyMediaStatus" Text="Disconnected" Foreground="{DynamicResource Lis2StatusTextBrush}" FontWeight="SemiBold"/>
              </Border>
            </Grid>
            <TextBlock Name="WmpLegacyMediaTitle" Text="Nothing playing" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="WmpLegacyMediaArtist" Text="Waiting for Windows Media Player Legacy..." FontSize="16" TextTrimming="CharacterEllipsis"/>
            <TextBlock Name="WmpLegacyMediaAlbum" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
            <Grid ColumnDefinitions="*,16,*,16,*" Margin="0,6,0,10">
              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock Text="Playback" FontWeight="SemiBold"/>
                <TextBlock Name="WmpLegacyMediaPlayback" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="WmpLegacyMediaTime" FontFamily="Consolas" Opacity="0.7"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock Text="Playlist" FontWeight="SemiBold"/>
                <TextBlock Name="WmpLegacyMediaPlaylist" Text="- / -" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>
              <StackPanel Grid.Column="4" Spacing="3">
                <TextBlock Text="Visualization" FontWeight="SemiBold"/>
                <TextBlock Name="WmpLegacyVisualizationStatus" Text="Disconnected" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
            <Separator/>
            <TextBlock Text="VU / Spectrum" FontWeight="SemiBold"/>
            <Grid ColumnDefinitions="25,*,45" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="8">
              <TextBlock Text="L" VerticalAlignment="Center"/>
              <ProgressBar Name="WmpLegacyVuLeft" Grid.Column="1" Maximum="255" Height="14"/>
              <TextBlock Name="WmpLegacyVuLeftValue" Grid.Column="2"/>
              <TextBlock Text="R" Grid.Row="1" VerticalAlignment="Center"/>
              <ProgressBar Name="WmpLegacyVuRight" Grid.Row="1" Grid.Column="1" Maximum="255" Height="14"/>
              <TextBlock Name="WmpLegacyVuRightValue" Grid.Row="1" Grid.Column="2"/>
            </Grid>
            <Grid Name="WmpLegacySpectrumBars" Height="70" ColumnSpacing="3"/>
            <TextBlock Name="WmpLegacyMediaTelemetry" FontFamily="Consolas" TextWrapping="Wrap"/>
            <TextBlock Name="WmpLegacyMediaConnection" TextWrapping="Wrap"/>
            <TextBlock Name="WmpLegacyVisualizationConnection" TextWrapping="Wrap"/>
            <Button Name="WmpLegacyMediaPage" Content="Create playback page" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="HomeAssistantView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Connection" FontWeight="SemiBold" FontSize="18" />
            <CheckBox Name="HaEnabled" Content="Enable Home Assistant" />
            <CheckBox Name="HaLocalTokenStorage" Content="Store token in a local AES file" />
            <WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,8">
                <TextBlock Text="URL" VerticalAlignment="Center" />
                <TextBox Name="HaUrl" Width="310" Watermark="http://homeassistant.local:8123" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,8">
                <TextBlock Text="Token" VerticalAlignment="Center" />
                <TextBox Name="HaToken" Width="240" PasswordChar="*" Watermark="Long-lived access token" />
              </StackPanel>
            </WrapPanel>
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="HaTest" Content="Test connection" />
              <Button Margin="0,0,8,8" Name="HaConnect" Content="Save / reconnect" />
            </WrapPanel>
            <TextBlock Name="HaActionStatus" IsVisible="False" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Home Assistant entities" FontWeight="SemiBold" FontSize="18" />
            <WrapPanel>
              <TextBox Margin="0,0,8,8" Name="HaEntityFilter" Width="240" Watermark="Search entity ID, friendly name or alias" />
              <ComboBox Margin="0,0,8,8" Name="HaEntityPicker" Width="370" />
              <ComboBox Margin="0,0,8,8" Name="HaDomainFilter" Width="220" />
            </WrapPanel>
            <TextBlock Name="HaStatus" Text="Not configured" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="34,2.4*,1.4*,1*,1.7*" Margin="8,4,8,0">
              <TextBlock Grid.Column="0" Text="★" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="1" Text="Entity" FontWeight="SemiBold"/>
              <TextBlock Grid.Column="2" Text="Friendly name" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,6,0"/>
              <TextBlock Grid.Column="3" Text="State" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,6,0"/>
              <TextBlock Grid.Column="4" Text="Template key" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Grid>
            <ListBox Name="HaEntityList" Focusable="True" MinHeight="160" MaxHeight="330">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="34,2.4*,1.4*,1*,1.7*" Margin="2,4">
                    <TextBlock Grid.Column="0" Text="{Binding Favorite}"/>
                    <TextBlock Grid.Column="1" Text="{Binding EntityId}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding FriendlyName}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="3" Text="{Binding State}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding TemplateKey}" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Selected entity" FontWeight="SemiBold" FontSize="18"/>
            <TextBlock Name="HaSelectedEntity" Text="Select an entity above." />
            <TextBlock Name="HaPreferenceStatus" TextWrapping="Wrap" />
            <WrapPanel><TextBlock Margin="0,0,8,8" Text="Alias" VerticalAlignment="Center" /><TextBox Margin="0,0,8,8" Name="HaAlias" Width="220" /><CheckBox Margin="0,0,8,8" Name="HaFavorite" Content="Favorite" /><Button Margin="0,0,8,8" Name="HaSaveEntity" Content="Save entity" /></WrapPanel>
            <WrapPanel><Button Margin="0,0,8,8" Name="HaCopyKey" Content="Copy key" /><Button Margin="0,0,8,8" Name="HaCreatePage" Content="Create display page" /></WrapPanel>
            <TextBlock Text="Attributes" FontWeight="SemiBold" />
            <ListBox Name="HaAttributes" Focusable="True" Height="150">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="2*,3*" Margin="2,4">
                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel><Button Margin="0,0,8,8" Name="HaCopyAttributeKey" Content="Copy key" /><Button Margin="0,0,8,8" Name="HaCreateAttributePage" Content="Create attribute page" /></WrapPanel>

          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Name="FanControlView" Grid.Row="1" IsVisible="False">
      <StackPanel Spacing="12">
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="Fan Outputs" FontSize="18" FontWeight="SemiBold"/><CheckBox Name="FanAutomatic" Grid.Column="1" Content="Automatic control" VerticalAlignment="Center"/></Grid>
            <Grid ColumnDefinitions="140,*,65" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
              <TextBlock Grid.Row="0" Text="Fan 1"/><ProgressBar Name="FanOutputBar1" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" Foreground="#17A45A"/><TextBlock Name="FanOutputText1" Grid.Row="0" Grid.Column="2" Text="—" TextAlignment="Right"/>
              <TextBlock Grid.Row="1" Text="Fan 2"/><ProgressBar Name="FanOutputBar2" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" Foreground="#17A45A"/><TextBlock Name="FanOutputText2" Grid.Row="1" Grid.Column="2" Text="—" TextAlignment="Right"/>
              <TextBlock Grid.Row="2" Text="Fan 3"/><ProgressBar Name="FanOutputBar3" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" Foreground="#17A45A"/><TextBlock Name="FanOutputText3" Grid.Row="2" Grid.Column="2" Text="—" TextAlignment="Right"/>
              <TextBlock Grid.Row="3" Text="Fan 4"/><ProgressBar Name="FanOutputBar4" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="0" Height="14" Foreground="#17A45A"/><TextBlock Name="FanOutputText4" Grid.Row="3" Grid.Column="2" Text="—" TextAlignment="Right"/>
            </Grid>
            <TextBlock Text="Preview values appear after simulation; they do not represent actual hardware output." FontSize="12" Opacity="0.7" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Fan channel configuration" FontSize="17" FontWeight="SemiBold" />
            <TextBlock Text="Physical fan outputs require explicit authorization. Configuration and previews do not send hardware commands." TextWrapping="Wrap" />
            <WrapPanel>
              <TextBlock Margin="0,0,8,8" Text="Channel" VerticalAlignment="Center" />
              <ComboBox Margin="0,0,8,8" Name="FanChannelPicker" Width="140" SelectedIndex="0">
                <ComboBoxItem Content="Fan 1" /><ComboBoxItem Content="Fan 2" />
                <ComboBoxItem Content="Fan 3" /><ComboBoxItem Content="Fan 4" />
              </ComboBox>
              <TextBlock Margin="0,0,8,8" Text="Mode" VerticalAlignment="Center" />
              <ComboBox Margin="0,0,8,8" Name="FanModePicker" Width="220" SelectedIndex="0">
                <ComboBoxItem Content="Fixed" /><ComboBoxItem Content="Curve" />
                <ComboBoxItem Content="Follow" /><ComboBoxItem Content="External" />
                <ComboBoxItem Content="Off" />
              </ComboBox>
            </WrapPanel>
            <Grid ColumnDefinitions="180,240" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Text="Name" /><TextBox Grid.Row="0" Grid.Column="1" Name="FanName" />
              <TextBlock Grid.Row="1" Text="Sensor key" />
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                <TextBox Name="FanSensorKey" />
                <ComboBox Name="FanSensorChoices" HorizontalAlignment="Stretch" PlaceholderText="Select a sensor above." />
              </StackPanel>
              <TextBlock Grid.Row="2" Text="Fixed percent" /><TextBox Grid.Row="2" Grid.Column="1" Name="FanFixed" />
              <TextBlock Grid.Row="3" Text="Minimum / maximum" />
              <WrapPanel Grid.Row="3" Grid.Column="1">
                <TextBox Margin="0,0,8,8" Name="FanMinimum" Width="110" /><TextBox Margin="0,0,8,8" Name="FanMaximum" Width="110" />
              </WrapPanel>
              <TextBlock Grid.Row="4" Text="Fail-safe percent" /><TextBox Grid.Row="4" Grid.Column="1" Name="FanFailSafe" />
              <TextBlock Grid.Row="5" Text="Hysteresis (C)" /><TextBox Grid.Row="5" Grid.Column="1" Name="FanHysteresis" />
              <TextBlock Grid.Row="6" Text="Allow stop" /><CheckBox Grid.Row="6" Grid.Column="1" Name="FanAllowStop" />
            </Grid>
            <TextBlock Text="Curve points (temperature=percent, one per line)" />
            <Grid ColumnDefinitions="250,18,330" RowDefinitions="Auto">
              <TextBox Grid.Column="0" Name="FanCurve" Height="154" HorizontalAlignment="Stretch" AcceptsReturn="True" />
              <Border Grid.Column="2" Background="{DynamicResource Lis2MutedCardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8">
                <StackPanel Spacing="5">
                  <TextBlock Text="Fan curve preview · 0-100 %" FontSize="12" Opacity="0.7"/>
                  <Canvas Width="300" Height="116" ClipToBounds="True">
                    <Path Stroke="#CBD5E1" StrokeThickness="1" Data="M 0,0 L 0,110 L 298,110"/>
                    <Path Stroke="#CBD5E1" StrokeThickness="1" Data="M 0,55 L 298,55"/>
                    <Path Name="FanCurvePreviewPath" Stroke="#15975A" StrokeThickness="2.5" StrokeLineCap="Round"/>
                  </Canvas>
                </StackPanel>
              </Border>
            </Grid>
            <Expander Name="FanCurvePointsExpander" Header="Curve points" HorizontalAlignment="Stretch">
              <StackPanel Spacing="7">
                <ListBox Name="FanCurvePointsList" MaxHeight="150"/>
                <WrapPanel>
                  <TextBlock Margin="0,0,8,8" Text="Temperature" VerticalAlignment="Center"/>
                  <TextBox Margin="0,0,8,8" Name="FanPointTemperature" Width="180"/>
                  <TextBlock Margin="0,0,8,8" Text="Fixed percent" VerticalAlignment="Center"/>
                  <TextBox Margin="0,0,8,8" Name="FanPointOutput" Width="80"/>
                  <Button Margin="0,0,8,8" Name="FanPointNew" Content="Add"/>
                  <Button Margin="0,0,8,8" Name="FanPointApply" Content="Apply point"/>
                  <Button Margin="0,0,8,8" Name="FanPointDelete" Content="Delete"/>
                </WrapPanel>
              </StackPanel>
            </Expander>
            <TextBlock Name="FanCurveStatus" TextWrapping="Wrap"/>
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="FanSave" Content="Save fan channel" />
            </WrapPanel>
            <Expander Name="FanTestTools" Header="Test tools" HorizontalAlignment="Stretch">
              <StackPanel Spacing="10">
            <WrapPanel>
              <TextBlock Margin="0,0,8,8" Text="Simulated sensor temperature" VerticalAlignment="Center" />
              <TextBox Margin="0,0,8,8" Name="FanSimulatedTemperature" Width="90" Text="50" />
              <Button Margin="0,0,8,8" Name="FanPreview" Content="Simulate all four channels" />
            </WrapPanel>
            <TextBlock Name="FanSensorSource" Text="Hardware" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="FanReadSensors" Content="List detected sensors" />
              <Button Margin="0,0,8,8" Name="FanLivePreview" Content="Preview with real sensor values (dry run)" />
            </WrapPanel>
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="FanMonitorStart" Content="Start continuous sensor preview (dry run)" />
              <Button Margin="0,0,8,8" Name="FanMonitorStop" Content="Stop preview" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Text="Virtual LIS2 protocol integration (no physical hardware)" FontWeight="SemiBold" />
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="FanVirtualStart" Content="Start virtual four-fan controller" />
              <Button Margin="0,0,8,8" Name="FanVirtualStop" Content="Stop and restore safety frame" IsEnabled="False" />
            </WrapPanel>
              </StackPanel>
            </Expander>
            <TextBlock Text="Physical LIS2 fans: explicit per-connection authorization (experimental)" FontWeight="SemiBold" />
            <TextBlock Text="Only use with a connected LIS2 and verified fan wiring. The first fan command sets all four fans to 100%. Stopping restores 100%. This feature is never auto-enabled by saved settings." TextWrapping="Wrap" />
            <CheckBox Name="FanHardwareConsent">
              <TextBlock Text="I explicitly authorize physical fan output for this connection" TextWrapping="Wrap" />
            </CheckBox>
            <WrapPanel>
              <Button Margin="0,0,8,8" Name="FanHardwareStart" Content="Enable physical four-fan control" IsEnabled="False" />
              <Button Margin="0,0,8,8" Name="FanHardwareStop" Content="Stop and restore 100% safety frame" IsEnabled="False" />
            </WrapPanel>
            <TextBlock Name="FanSensorStatus" Text="Sensor discovery has not run." TextWrapping="Wrap" />
            <TextBlock Name="FanPreviewStatus" Text="Physical fan output disabled." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
      <ScrollViewer Name="HardwareView" Grid.Row="1" IsVisible="False">
        <StackPanel Spacing="12">
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16"><StackPanel Spacing="12">
          <TextBlock Text="Hardware monitoring" FontSize="18" FontWeight="SemiBold" />
          <WrapPanel>
            <Button Margin="0,0,8,8" Name="HardwareRefresh" Content="Refresh sensors" />
            <Button Margin="0,0,8,8" Name="HardwareAutoRefresh" Content="Start live updates" />
            <TextBox Margin="0,0,8,8" Name="HardwareSearch" Width="220" Watermark="Search alias or sensor key" />
            <ComboBox Margin="0,0,8,8" Name="HardwareTypeFilter" Width="160" SelectedIndex="0">
              <ComboBoxItem Content="All types" />
              <ComboBoxItem Content="Favorites" />
              <ComboBoxItem Content="Unavailable" />
              <ComboBoxItem Content="Temperature" />
              <ComboBoxItem Content="Load" />
              <ComboBoxItem Content="Fan" />
              <ComboBoxItem Content="Clock" />
              <ComboBoxItem Content="Voltage" />
              <ComboBoxItem Content="Power" />
              <ComboBoxItem Content="Data" />
              <ComboBoxItem Content="Throughput" />
              <ComboBoxItem Content="Other" />
            </ComboBox>
          </WrapPanel>
          <CheckBox Name="HardwareFavoritesOnly" Content="Favorites only" />
                    <Grid ColumnDefinitions="34,2.1*,1.1*,1*,2.8*" Margin="8,0,8,4"><TextBlock Grid.Column="0" Text="★" /><TextBlock Grid.Column="1" Text="Sensor" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="Type" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="Value" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="Template key" FontWeight="SemiBold" /></Grid>
          <ListBox Name="HardwareSensorList" MinHeight="260" MaxHeight="450">
            <ListBox.DataTemplates>
              <DataTemplate DataType="local:HardwareSensorGroupHeader">
                <Border Background="{DynamicResource Lis2HeaderBrush}" Padding="8,6" Margin="0,8,0,4">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                </Border>
              </DataTemplate>
              <DataTemplate DataType="local:HardwareSensorEntry">
                <Grid ColumnDefinitions="34,2.1*,1.1*,1*,2.8*" Margin="2,3">
                  <TextBlock Grid.Column="0" Text="{Binding Markers}" />
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SensorName}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding DisplaySensorType}" />
                  <TextBlock Grid.Column="3" Text="{Binding DisplayValue}" FontFamily="Consolas" />
                  <TextBlock Grid.Column="4" Text="{Binding Key}" FontFamily="Consolas" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </Grid>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
        </StackPanel></Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Selected sensor / fan assignment" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Name="HardwareSelectedSensor" Text="Select a sensor above." TextWrapping="Wrap" />
          <WrapPanel>
            <TextBox Margin="0,0,8,8" Name="HardwareAlias" Width="260" Watermark="Alias for selected sensor" />
            <CheckBox Margin="0,0,8,8" Name="HardwareFavorite" Content="Favorite" VerticalAlignment="Center" />
            <Button Margin="0,0,8,8" Name="HardwareSavePreference" Content="Save sensor preference" />
          </WrapPanel>
          <TextBlock Name="HardwareSensorStatus" Text="Refresh to discover available sensors." TextWrapping="Wrap" />
          <TextBlock Name="HardwareSaveStatus" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Margin="0,0,8,8" Name="HardwareUseForFan" Content="Use for Fan 1" IsEnabled="False" />
            <Button Margin="0,0,8,8" Name="HardwareUseForFan2" Content="Fan 2" IsEnabled="False" />
            <Button Margin="0,0,8,8" Name="HardwareUseForFan3" Content="Fan 3" IsEnabled="False" />
            <Button Margin="0,0,8,8" Name="HardwareUseForFan4" Content="Fan 4" IsEnabled="False" />
          </WrapPanel>
          <TextBlock Text="Sensor assignment updates the fan editor but is not saved until you explicitly save fan configuration. Physical fan output remains disabled unless separately authorized." TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="10">
          <TextBlock Text="Display presets" FontSize="16" FontWeight="SemiBold" />
          <WrapPanel>
            <Button Margin="0,0,8,8" Name="HardwarePresetCPU" Content="CPU" />
            <Button Margin="0,0,8,8" Name="HardwarePresetGPU" Content="GPU" />
            <Button Margin="0,0,8,8" Name="HardwarePresetMemory" Content="Memory" />
            <Button Margin="0,0,8,8" Name="HardwarePresetTemperatures" Content="Temperatures" />
            <Button Margin="0,0,8,8" Name="HardwarePresetFans" Content="Fans" />
          </WrapPanel>
        </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="DiagnosticsView" Grid.Row="1" IsVisible="False">
        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto" Margin="0,0,8,8">
          <Border Background="{DynamicResource Lis2CardBrush}" Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Diagnostics Snapshot" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="DiagnosticsExport" Content="Export report..." />
                <Button Name="DiagnosticsRefresh" Content="Refresh" />
              </StackPanel>
              <TextBox Name="DiagnosticsSnapshot" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="210" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Virtual LIS2 state" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBox Name="DiagnosticsVirtualState" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Decoded command history" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBox Name="DiagnosticsCommandHistory" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" Grid.Row="2" Grid.Column="2" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Protocol Log" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBox Name="DiagnosticsProtocolLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Height="245" FontFamily="Consolas" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
      <ScrollViewer Name="EventsView" Grid.Row="1" IsVisible="False">
        <StackPanel Spacing="14">
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <Grid ColumnDefinitions="100,*,110,120" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="9">
              <TextBlock Grid.Row="0" Text="Line 1" VerticalAlignment="Center"/>
              <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Name="EventLine1" MaxLength="20" Text="BUILD FINISHED"/>
              <TextBlock Grid.Row="1" Text="Line 2" VerticalAlignment="Center"/>
              <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Name="EventLine2" MaxLength="20" Text="0 errors"/>
              <TextBlock Grid.Row="2" Text="Priority" VerticalAlignment="Center"/>
              <ComboBox Grid.Row="2" Grid.Column="1" Name="EventPriority" HorizontalAlignment="Left" Width="180" SelectedIndex="1">
                <ComboBoxItem Content="Info (10)"/>
                <ComboBoxItem Content="Notice (50)"/>
                <ComboBoxItem Content="Warning (100)"/>
                <ComboBoxItem Content="Critical (200)"/>
              </ComboBox>
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Duration (s)" VerticalAlignment="Center"/>
              <TextBox Grid.Row="2" Grid.Column="3" Name="EventDuration" Text="5"/>
              <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
                <Button Name="EventShow" Content="Show event"/>
                <Button Name="EventTestWarning" Content="Test warning"/>
                <Button Name="EventClear" Content="Clear all"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10" MinHeight="380">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Active / queued events" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Name="EventCount" Text="0 events" VerticalAlignment="Center" Opacity="0.65"/>
              </StackPanel>
              <ListBox Grid.Row="1" Name="EventList" MinHeight="220" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="1.8*,3*,1.1*" Margin="2,4">
                      <TextBlock Grid.Column="0" Text="{Binding PriorityName}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Grid.Column="2" Text="{Binding Remaining}" FontFamily="Consolas" HorizontalAlignment="Right" Opacity="0.7"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBlock Name="EventStatus" Text="Select an event to display." Opacity="0.7" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Name="EventCancel" Content="Cancel selected"/>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer Name="SettingsView" Grid.Row="1" IsVisible="False"><StackPanel Spacing="14">
          <Border BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Name="SettingsDeviceHeading" Text="Device / Transport" FontWeight="SemiBold" FontSize="18"/>
              <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                <TextBlock Grid.Row="0" Name="SettingsTransportLabel" Text="Transport" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Name="TransportModeComboBox" SelectedIndex="0" Width="220" HorizontalAlignment="Left">
                  <ComboBoxItem Content="Virtual"/>
                  <ComboBoxItem Content="Serial"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Name="SettingsPortLabel" Text="COM port" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="SettingsPortComboBox" Width="220" HorizontalAlignment="Left"/>
              </Grid>
              <WrapPanel>
                <Button Name="SettingsRefreshPorts" Content="Refresh" Margin="0,0,8,0"/>
                <Button Name="SettingsApplyTransport" Content="Apply / reconnect" Margin="0,0,8,0"/>
                <Button Name="SettingsDisconnectTransport" Content="Disconnect"/>
              </WrapPanel>
              <TextBlock Name="SettingsTransportStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Name="SettingsAppearanceHeading" Text="Appearance" FontWeight="SemiBold" FontSize="18"/>
              <Grid ColumnDefinitions="100,220,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="10">
                <TextBlock Grid.Row="0" Name="SettingsThemeLabel" Text="Theme" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="1" Name="ThemeModeComboBox">
                  <ComboBoxItem Content="System default"/>
                  <ComboBoxItem Content="Light"/>
                  <ComboBoxItem Content="Dark"/>
                </ComboBox>
                <TextBlock Grid.Row="1" Name="SettingsLanguageLabel" Text="Language" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Name="LanguageModeComboBox">
                  <ComboBoxItem Content="System default"/>
                  <ComboBoxItem Content="English"/>
                  <ComboBoxItem Content="German"/>
                  <ComboBoxItem Content="French"/>
                  <ComboBoxItem Content="Turkish"/>
                  <ComboBoxItem Content="Russian"/>
                </ComboBox>
              </Grid>
              <TextBlock Name="SettingsAppearanceStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" Name="SettingsWindowsCard" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
            <StackPanel Spacing="12">
              <TextBlock Text="Desktop startup" FontWeight="SemiBold" FontSize="18"/>
              <CheckBox Name="StartWithWindowsCheckBox" Content="Start LIS2 Control Center with Windows (minimized to tray)">
                <CheckBox.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></CheckBox.ContentTemplate>
              </CheckBox>
              <TextBlock Name="SettingsStartupStatus" TextWrapping="Wrap" Opacity="0.75"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Lis2CardBrush}" BorderBrush="{DynamicResource Lis2BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
          <StackPanel Spacing="12">
            <TextBlock Text="Windows settings" FontSize="18" FontWeight="SemiBold"/>
            <Button Name="ImportWindowsSettings" Content="Import Windows settings.json..." />
            <TextBlock Name="WindowsImportStatus" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
          </Border>
          <StackPanel IsVisible="False" Spacing="10">
          <TextBlock Name="VirtualStatus" Text="Disconnected" TextWrapping="Wrap" Opacity="0.75"/>
          <Separator Margin="0,12,0,4"/>
          <TextBlock Text="Device / Transport" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Experimental serial and virtual transport diagnostics. No hardware fan authorization is implied." TextWrapping="Wrap"/>          <Separator Margin="4,18,4,16" />
          <TextBlock Text="Transport" FontWeight="SemiBold" Margin="4,0,0,8" />


          <Separator Margin="0,12,0,4" />
          <TextBlock Text="Serial display" FontWeight="SemiBold" />
          <ComboBox Name="SerialPortPicker" MinWidth="180" />
          <Button Name="SerialRefreshPorts" Content="Refresh serial ports" HorizontalAlignment="Left" />
          <Button Name="SerialConnect" Content="Connect serial display" HorizontalAlignment="Left" />
          <Button Name="SerialDisconnect" Content="Disconnect serial" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendLines" Content="Send display lines" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStart" Content="Start serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialPlaybackStop" Content="Stop serial page sequence" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialPlaybackStatus" Text="Serial sequence stopped" TextWrapping="Wrap" />
          <Button Name="SerialSendPage" Content="Send selected page" HorizontalAlignment="Left" IsEnabled="False" />
          <Button Name="SerialSendGlyphs" Content="Program 8 glyphs" HorizontalAlignment="Left" IsEnabled="False" />
          <WrapPanel>
            <TextBlock Margin="0,0,5,5" Text="Brightness" VerticalAlignment="Center" />
            <ComboBox Margin="0,0,5,5" Name="SerialBrightness" SelectedIndex="0" Width="75">
              <ComboBoxItem Content="100%" />
              <ComboBoxItem Content="75%" />
              <ComboBoxItem Content="50%" />
              <ComboBoxItem Content="25%" />
            </ComboBox>
            <Button Margin="0,0,5,5" Name="SerialApplyBrightness" Content="Apply" IsEnabled="False" />
          </WrapPanel>
          <Button Name="SerialClear" Content="Clear serial display" HorizontalAlignment="Left" IsEnabled="False" />
          <TextBlock Name="SerialStatus" Text="Serial display disconnected; fan control unavailable." TextWrapping="Wrap" />
          <Button Name="VirtualConnect" Content="Connect virtual LIS2" HorizontalAlignment="Left" />
          <Button Name="VirtualDisconnect" Content="Disconnect" IsEnabled="False" HorizontalAlignment="Left" />

          </StackPanel>
</StackPanel></ScrollViewer>
      <TextBlock Grid.Row="2" Name="DeviceActionStatus" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </Grid>
  </Grid>
</Window>
