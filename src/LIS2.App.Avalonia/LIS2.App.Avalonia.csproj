<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LIS2.App.Avalonia</AssemblyName>
    <RootNamespace>LIS2.App.Avalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="LIS2.App.Avalonia.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <!-- Sicherheitskorrektur für die von Avalonia verwendete DBus-Version, GHSA-xrw6-gwf8-vvr9. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <ProjectReference Include="../LIS2.Core/LIS2.Core.csproj" />
    <ProjectReference Include="../LIS2.Winamp/LIS2.Winamp.csproj" />
    <ProjectReference Include="../LIS2.Display/LIS2.Display.csproj" />
    <ProjectReference Include="../LIS2.Fans/LIS2.Fans.csproj" />
    <ProjectReference Include="../LIS2.Runtime/LIS2.Runtime.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="DisplayRuntimeHost.cs" />
    <Compile Remove="PagePlayback.cs" />
    <Compile Remove="PageDefinition.cs" />
    <Compile Remove="PageFrameDispatcher.cs" />
    <Compile Remove="PageSourceValues.cs" />
    <Compile Remove="PageClockValues.cs" />
    <Compile Remove="PeriodicRuntimeLoop.cs" />
    <Compile Remove="PageSequenceController.cs" />
  </ItemGroup>
</Project>
