<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>LIS2.App.Avalonia</AssemblyName>
    <RootNamespace>LIS2.App.Avalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <ProjectReference Include="../LIS2.Core/LIS2.Core.csproj" />
    <ProjectReference Include="../LIS2.Display/LIS2.Display.csproj" />
    <ProjectReference Include="../LIS2.Fans/LIS2.Fans.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../LIS2.Sources/IDataSource.cs" Link="Sources/IDataSource.cs" />
    <Compile Include="../LIS2.Sources/DataSourceRegistry.cs" Link="Sources/DataSourceRegistry.cs" />
    <Compile Include="../LIS2.Sources/ClockDataSource.cs" Link="Sources/ClockDataSource.cs" />
  </ItemGroup>
</Project>
